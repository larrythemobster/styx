<rml>
<head>
	<title>Styx</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="theme.rcss"/>
	<link type="text/rcss" href="rail.rcss"/>
	<link type="text/rcss" href="channels.rcss"/>
	<link type="text/rcss" href="userpanel.rcss"/>
	<link type="text/rcss" href="chat.rcss"/>
	<link type="text/rcss" href="members.rcss"/>
	<link type="text/rcss" href="call.rcss"/>
	<link type="text/rcss" href="friends.rcss"/>
</head>
<body>
	<!-- Each region is filled by one controller (src/UI/Rml/*Controller.cpp). -->
	<div id="rail"></div>
	<div id="sidebar">
		<div id="sidebar-header"></div>
		<div id="channel-list"></div>
		<div id="voice-panel"></div>
		<div id="user-panel"></div>
	</div>
	<div id="main">
		<div id="header"></div>
		<div id="content">
			<div id="chat">
				<div id="messages"></div>
				<div id="typing"></div>
				<div id="composer"></div>
			</div>
			<div id="call"></div>
			<div id="members"></div>
			<div id="friends"></div>
		</div>
	</div>
	<div id="overlay"></div>
</body>
</rml>
