<rml>
<head>
	<title>Styx</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="theme.rcss"/>
	<link type="text/rcss" href="rail.rcss"/>
	<link type="text/rcss" href="channels.rcss"/>
	<link type="text/rcss" href="userpanel.rcss"/>
	<link type="text/rcss" href="chat.rcss"/>
	<link type="text/rcss" href="members.rcss"/>
	<link type="text/rcss" href="call.rcss"/>
	<link type="text/rcss" href="friends.rcss"/>
	<link type="text/rcss" href="settings.rcss"/>
</head>
<body>
	<div id="titlebar">
		<div class="titlebar-navigation">
			<button class="titlebar-action" id="titlebar-back" data-toolbar-action="back" title="Back" aria-label="Back"><img src="icon:arrow-left"/></button>
			<button class="titlebar-action" id="titlebar-forward" data-toolbar-action="forward" title="Forward" aria-label="Forward"><img src="icon:arrow-right"/></button>
		</div>
		<div class="titlebar-center"><img id="titlebar-context-icon" src="icon:gamepad-2"/><span id="titlebar-context">Direct Messages</span></div>
		<div class="titlebar-app-actions">
			<button class="titlebar-action" id="titlebar-inbox" data-toolbar-action="inbox" title="Inbox" aria-label="Inbox"><img src="icon:inbox"/></button>
			<button class="titlebar-action" data-toolbar-action="help" title="Keyboard shortcuts" aria-label="Help"><img src="icon:circle-question-mark"/></button>
			<button class="titlebar-action" id="titlebar-update" data-toolbar-action="update" title="Updates" aria-label="Updates"><img src="icon:download"/></button>
			<div class="titlebar-separator"></div>
		</div>
		<div class="titlebar-controls">
			<button id="titlebar-minimize" class="titlebar-button" data-window-action="minimize" title="Minimize" aria-label="Minimize"><span class="titlebar-minimize-icon"></span></button>
			<button id="titlebar-maximize" class="titlebar-button" data-window-action="maximize" title="Maximize" aria-label="Maximize"><span class="titlebar-maximize-icon"><span class="titlebar-restore-icon"></span></span></button>
			<button id="titlebar-close" class="titlebar-button titlebar-close" data-window-action="close" title="Close" aria-label="Close"><img class="titlebar-close-icon" src="icon:x"/></button>
		</div>
	</div>
	<div id="titlebar-hint" role="tooltip"></div>
	<div id="frame">
	<!-- Each region is filled by one controller (src/UI/Rml/*Controller.cpp). -->
	<div id="rail"></div>
	<div id="sidebar">
		<div id="sidebar-header"></div>
		<div id="channel-list"></div>
		<div id="voice-panel"></div>
		<div id="user-panel"></div>
	</div>
	<div id="main">
		<div id="header"></div>
		<div id="content">
			<div id="chat">
				<div id="messages"></div>
				<div id="typing"></div>
				<div id="composer"></div>
			</div>
			<div id="call"></div>
			<div id="members"></div>
			<div id="friends"></div>
		</div>
	</div>
	</div>
	<div id="updates-backdrop" class="updates-backdrop">
		<div id="updates-panel" class="updates-panel">
			<div class="updates-heading">Updates <button id="updates-close" data-update-action="close" class="updates-close" aria-label="Close">×</button></div>
			<div id="updates-current" class="updates-detail"></div>
			<div id="updates-status" class="updates-status"></div>
			<div class="updates-actions">
				<button id="updates-retry" data-update-action="retry" class="updates-button">Check again</button>
				<button data-update-action="open" class="updates-button updates-primary">View releases</button>
			</div>
		</div>
	</div>
	<div id="settings-overlay"></div>
	<div id="overlay"></div>
</body>
</rml>
