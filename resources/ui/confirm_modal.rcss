#confirm-modal-root
{
	position: absolute;
	top: 0;
	left: 0;
	width: 100%;
	height: 100%;
	z-index: 2000;
	display: none;
	background-color: transparent;
}

#confirm-modal-root.open
{
	display: block;
}

.modal-backdrop
{
	width: 100%;
	height: 100%;
	background-color: #000000b3;
	display: flex;
	justify-content: center;
	align-items: center;
}

.modal-card
{
	width: 440dp;
	max-width: 90%;
	background-color: #313338;
	border-radius: 6dp;
	display: flex;
	flex-direction: column;
	overflow: hidden;
}

.modal-header
{
	padding: 20dp 20dp 12dp 20dp;
}

.modal-title
{
	font-size: 20dp;
	font-weight: bold;
	color: #f2f3f5;
	margin: 0;
}

.modal-body
{
	padding: 0 20dp 20dp 20dp;
}

.modal-message
{
	font-size: 14dp;
	line-height: 20dp;
	color: #dbdee1;
}

.modal-footer
{
	background-color: #2b2d31;
	padding: 16dp 20dp;
	display: flex;
	flex-direction: row;
	justify-content: flex-end;
	align-items: center;
}

.btn
{
	font-size: 14dp;
	font-weight: 500;
	padding: 8dp 18dp;
	border-radius: 4dp;
	cursor: pointer;
	border-width: 0;
	text-align: center;
}

.btn-cancel
{
	background-color: transparent;
	color: #ffffff;
	margin-right: 12dp;
}

.btn-cancel:hover
{
	text-decoration: underline;
}

.btn-confirm
{
	background-color: #5865f2;
	color: #ffffff;
}

.btn-confirm:hover
{
	background-color: #4752c4;
}

.btn-confirm.danger
{
	background-color: #da373c;
}

.btn-confirm.danger:hover
{
	background-color: #a12828;
}
