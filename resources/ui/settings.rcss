/*
 * User settings, using the dark palette shared with theme.rcss.
 */

#settings-overlay
{
	position: absolute;
	top: 0;
	left: 0;
	width: 100%;
	height: 100%;
	z-index: 1000;
	display: none;
	align-items: center;
	justify-content: center;
}

#settings-overlay.open
{
	display: flex;
}

body.custom-titlebar #settings-overlay
{
	top: 28dp;
	bottom: 0;
	height: auto;
}

.settings-backdrop
{
	position: absolute;
	top: 0;
	left: 0;
	width: 100%;
	height: 100%;
	background-color: #000000b8;
}

.settings-dialog
{
	position: relative;
	display: flex;
	flex-direction: row;
	width: 94%;
	height: 90%;
	max-width: 1120dp;
	max-height: 900dp;
	min-height: 0;
	box-sizing: border-box;
	background-color: #000000;
	border: 1dp #303035;
	border-radius: 8dp;
	overflow: hidden;
}

/* --- Left Sidebar --- */

.settings-sidebar
{
	width: 220dp;
	height: 100%;
	flex-shrink: 0;
	background-color: #0b0b0c;
	border-right: 1dp #202024;
	box-sizing: border-box;
	display: flex;
	flex-direction: column;
	padding: 24dp 12dp 24dp 16dp;
	overflow-y: auto;
}

.settings-group-header
{
	font-size: 11dp;
	font-weight: bold;
	color: #949ba4;
	text-transform: uppercase;
	padding: 6dp 10dp;
	margin-top: 14dp;
	margin-bottom: 2dp;
}

.settings-group-header:first-child
{
	margin-top: 0;
}

.settings-nav-item
{
	display: block;
	padding: 8dp 10dp;
	margin-bottom: 2dp;
	border-radius: 4dp;
	color: #949ba4;
	font-size: 14dp;
	font-weight: 500;
	cursor: pointer;
	tab-index: auto;
}

.settings-nav-item:hover
{
	background-color: #19191c;
	color: #dbdee1;
}

.settings-nav-item.active
{
	background-color: #242428;
	color: #ffffff;
	font-weight: 600;
}

.settings-nav-item:focus
{
	background-color: #242428;
	color: #ffffff;
}

.settings-divider
{
	height: 1dp;
	background-color: #202024;
	margin: 12dp 8dp;
}

.settings-sidebar-footer
{
    margin-top: auto;
    padding: 16dp 10dp 0 10dp;
}

.settings-app-version
{
    font-size: 12dp;
    color: #949ba4;
    font-weight: 600;
    margin-bottom: 4dp;
}

.settings-credit
{
    font-size: 11dp;
    color: #72767d;
}

/* --- Right Content Pane --- */

.settings-content-pane
{
	flex: 1;
	height: 100%;
	min-width: 0;
	background-color: #000000;
	box-sizing: border-box;
	overflow-y: auto;
	position: relative;
	display: flex;
	flex-direction: column;
}

.settings-content-wrapper
{
    width: 100%;
    max-width: 760dp;
    padding: 32dp 40dp 64dp 40dp;
    box-sizing: border-box;
}

.settings-section-title
{
	font-size: 22dp;
	font-weight: bold;
	color: #f2f3f5;
	margin-bottom: 20dp;
	padding-right: 40dp;
}

/* Close ESC Button */

.settings-close-container
{
	position: absolute;
	top: 20dp;
	right: 24dp;
	display: flex;
	flex-direction: column;
	align-items: center;
	z-index: 10;
}

.settings-close-btn
{
	width: 32dp;
	height: 32dp;
	border: 1dp #000000;
	border-radius: 4dp;
	box-sizing: border-box;
	display: flex;
	align-items: center;
	justify-content: center;
	cursor: pointer;
	tab-index: auto;
	background-color: #111214;
}

.settings-close-btn:hover, .settings-close-btn:focus
{
	background-color: #303035;
}

.settings-close-btn:active
{
	background-color: #48484e;
}

.settings-close-btn img
{
	width: 18dp;
	height: 18dp;
	image-color: #b5bac1;
}

.settings-close-btn:hover img
{
	image-color: #ffffff;
}


/* --- Form Widgets & Controls --- */

.settings-card
{
	border-bottom: 1dp #202024;
	padding: 0 0 24dp 0;
	margin-bottom: 24dp;
	box-sizing: border-box;
}

.settings-row
{
	margin-bottom: 20dp;
}

.settings-label
{
	display: block;
	font-size: 13dp;
	font-weight: 600;
	color: #b5bac1;
	margin-bottom: 8dp;
}

.settings-description
{
	font-size: 13dp;
	color: #949ba4;
	line-height: 18dp;
	margin-bottom: 10dp;
}

.settings-note
{
	font-size: 12dp;
	color: #f0b232;
	font-style: italic;
	margin-top: 4dp;
}

.settings-subheading
{
	font-size: 12dp;
	font-weight: bold;
	color: #949ba4;
	text-transform: uppercase;
	margin-top: 24dp;
	margin-bottom: 10dp;
}

.settings-grid-2col
{
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	gap: 16dp;
	margin-bottom: 20dp;
}

.settings-grid-col
{
	flex: 1 1 220dp;
	min-width: 0;
}


/* Toggle Switch Row */

.settings-switch-row
{
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
	padding: 14dp 0;
	border-bottom: 1dp #202024;
}

.settings-switch-row:last-child
{
	border-bottom-width: 0;
}

.settings-switch-text
{
	flex: 1;
	min-width: 0;
	margin-right: 16dp;
}

.settings-switch-title
{
	font-size: 15dp;
	font-weight: 500;
	color: #dbdee1;
	margin-bottom: 2dp;
}

.settings-switch-desc
{
	font-size: 12dp;
	color: #949ba4;
	line-height: 16dp;
}

/* Discord Toggle Switch */

.settings-switch
{
	width: 44dp;
	height: 24dp;
	flex-shrink: 0;
	background-color: #4e5058;
	border-radius: 12dp;
	position: relative;
	cursor: pointer;
	box-sizing: border-box;
	tab-index: auto;
}

.settings-switch:hover, .settings-switch:focus
{
	background-color: #6d6f78;
}

.settings-switch.checked
{
	background-color: #23a55a;
}

.settings-switch.checked:hover, .settings-switch.checked:focus
{
	background-color: #2dc76d;
}

.settings-switch-thumb
{
	position: absolute;
	top: 3dp;
	left: 3dp;
	width: 18dp;
	height: 18dp;
	background-color: #ffffff;
	border-radius: 9dp;
}

.settings-switch.checked .settings-switch-thumb
{
	left: 23dp;
}

/* Sliders */

.settings-slider-wrap
{
	position: relative;
	margin-bottom: 20dp;
}

.settings-slider-header
{
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
	margin-bottom: 6dp;
}

.settings-slider-val
{
	min-width: 56dp;
	margin-left: 12dp;
	flex-shrink: 0;
	text-align: right;
	font-size: 14dp;
	font-weight: 600;
	color: #f2f3f5;
}

.settings-slider-hint
{
	position: absolute;
	top: -8dp;
	box-sizing: content-box;
	visibility: hidden;
	pointer-events: none;
	z-index: 20;
	padding: 6dp 8dp;
	background-color: #111214;
	border: 1dp #303035;
	border-radius: 4dp;
	color: #f2f3f5;
	font-size: 12dp;
	font-weight: 600;
	line-height: 16dp;
	white-space: nowrap;
}

.settings-slider-wrap.hint-visible .settings-slider-hint
{
	visibility: visible;
}

.settings-slider-wrap.hint-visible .settings-slider-val
{
	visibility: hidden;
}

input.settings-slider
{
	width: 100%;
	height: 24dp;
}

input.settings-slider slidertrack
{
	background-color: #4e5058;
	height: 4dp;
	border-radius: 2dp;
	margin-top: 10dp;
}

input.settings-slider sliderprogress
{
	background-color: #5865f2;
	height: 4dp;
	border-radius: 2dp;
	margin-top: 0;
}

input.settings-slider sliderbar
{
	background-color: #ffffff;
	width: 16dp;
	height: 16dp;
	border-radius: 8dp;
	margin-top: 4dp;
	margin-left: -8dp;
	margin-right: -8dp;
}

input.settings-slider sliderbar:hover
{
	background-color: #dbdee1;
}

input.settings-slider sliderbar:active
{
	background-color: #f2f3f5;
}

input.settings-slider sliderarrowdec,
input.settings-slider sliderarrowinc
{
	width: 0;
	height: 0;
}

/* Dropdown Select */

select.settings-select
{
	width: 100%;
	height: 40dp;
	background-color: #111214;
	border: 1dp #303035;
	border-radius: 4dp;
	color: #dbdee1;
	font-size: 14dp;
	box-sizing: border-box;
}

select.settings-select:hover, select.settings-select:focus
{
	border-color: #72767d;
}

select.settings-select selectvalue
{
	padding: 9dp 12dp;
	line-height: 20dp;
	white-space: nowrap;
	overflow: hidden;
	color: #dbdee1;
}

select.settings-select selectarrow
{
	width: 16dp;
	height: 16dp;
	margin: 11dp 10dp;
	decorator: image(icon:chevron-down);
}

select.settings-select selectbox
{
	background-color: #111214;
	border: 1dp #202024;
	border-radius: 4dp;
	padding: 4dp;
	z-index: 200;
	max-height: 220dp;
	overflow-y: auto;
}

select.settings-select selectbox option
{
	padding: 8dp 10dp;
	border-radius: 4dp;
	color: #dbdee1;
}

select.settings-select selectbox option:hover
{
	background-color: #242428;
	color: #ffffff;
}

/* Radio Cards */

.settings-radio-group
{
	display: flex;
	flex-direction: column;
	margin-bottom: 16dp;
}

.settings-radio-card
{
	display: flex;
	flex-direction: row;
	align-items: center;
	background-color: transparent;
	border: 1dp transparent;
	border-radius: 4dp;
	padding: 10dp 8dp;
	margin-bottom: 2dp;
	cursor: pointer;
	box-sizing: border-box;
	tab-index: auto;
}

.settings-radio-card:hover, .settings-radio-card:focus
{
	background-color: #19191c;
	border-color: #4e5058;
}

.settings-radio-card.active
{
	background-color: #19191c;
	border-color: #4e5058;
}

.settings-radio-indicator
{
	width: 20dp;
	height: 20dp;
	border-radius: 10dp;
	border: 2dp #4e5058;
	margin-right: 12dp;
	flex-shrink: 0;
	box-sizing: border-box;
	position: relative;
}

.settings-radio-card.active .settings-radio-indicator
{
	border-color: #5865f2;
}

.settings-radio-dot
{
	position: absolute;
	top: 4dp;
	left: 4dp;
	width: 8dp;
	height: 8dp;
	border-radius: 4dp;
}

.settings-radio-card.active .settings-radio-dot
{
	background-color: #5865f2;
}

.settings-radio-info
{
	flex: 1;
	min-width: 0;
}

.settings-radio-title
{
	font-size: 14dp;
	font-weight: 600;
	color: #f2f3f5;
	margin-bottom: 2dp;
}

.settings-radio-desc
{
	font-size: 12dp;
	color: #949ba4;
}

/* Buttons */

.settings-btn
{
	display: flex;
	align-items: center;
	justify-content: center;
	flex-shrink: 0;
	height: 38dp;
	padding: 0 16dp;
	border: 1dp #000000;
	border-radius: 4dp;
	font-size: 14dp;
	font-weight: 600;
	cursor: pointer;
	tab-index: auto;
	box-sizing: border-box;
}

.settings-btn-label
{
	display: block;
	white-space: nowrap;
	text-align: center;
}

.settings-btn-icon
{
	width: 16dp;
	height: 16dp;
	image-color: #ffffff;
}


.settings-btn-primary
{
	background-color: #5865f2;
	color: #ffffff;
}

.settings-btn-primary:hover, .settings-btn-primary:focus
{
	background-color: #4752c4;
}

.settings-btn-secondary
{
	background-color: #303035;
	color: #ffffff;
}

.settings-btn-secondary:hover, .settings-btn-secondary:focus
{
	background-color: #48484e;
}

.settings-btn-danger
{
	background-color: #f23f43;
	color: #ffffff;
}

.settings-btn-danger:hover, .settings-btn-danger:focus
{
	background-color: #da373c;
}
.settings-keybind [data-action="remove-keybind"]
{
    background-color: #111214;
    color: #f23f43;
}

.settings-keybind [data-action="remove-keybind"]:hover,
.settings-keybind [data-action="remove-keybind"]:focus
{
    background-color: #303035;
}

.settings-btn-primary:active, .settings-btn-secondary:active, .settings-btn-danger:active
{
	background-color: #242428;
}

.settings-btn-primary:disabled, .settings-btn-secondary:disabled, .settings-btn-danger:disabled
{
	background-color: #242428;
	color: #72767d;
	cursor: default;
}

/* My Account Section */

.my-account-card
{
	background-color: #08080a;
	border: 1dp #202024;
	border-radius: 6dp;
	padding: 20dp;
	margin-bottom: 20dp;
	box-sizing: border-box;
}

.my-account-profile-header
{
	display: flex;
	flex-direction: row;
	align-items: center;
	margin-bottom: 20dp;
}

.my-account-avatar
{
	width: 80dp;
	height: 80dp;
	border-radius: 40dp;
	margin-right: 20dp;
	border: 3dp #08080a;
}

.my-account-names
{
	flex: 1;
	min-width: 0;
}

.my-account-display-name
{
	font-size: 20dp;
	font-weight: bold;
	color: #f2f3f5;
	margin-bottom: 4dp;
}

.my-account-username
{
	font-size: 14dp;
	color: #949ba4;
}

.my-account-field-card
{
	border-bottom: 1dp #202024;
	padding: 12dp 0;
	margin-bottom: 0;
	display: flex;
	flex-direction: column;
}

.my-account-field-label
{
	font-size: 11dp;
	font-weight: bold;
	color: #949ba4;
	text-transform: uppercase;
	margin-bottom: 4dp;
}

.my-account-field-value
{
	font-size: 14dp;
	color: #f2f3f5;
	word-break: break-all;
}

/* Appearance generator controls */

.settings-color-row
{
    margin-bottom: 16dp;
}

.settings-color-field
{
    display: flex;
    flex-direction: column;
}

.settings-color-label
{
    font-size: 12dp;
    color: #b5bac1;
    margin-bottom: 6dp;
}

.settings-color-input-row
{
    display: flex;
    flex-direction: row;
    align-items: center;
}

.settings-color-swatch
{
    width: 36dp;
    height: 36dp;
    border-radius: 4dp;
    border: 1dp #4e5058;
    margin-right: 10dp;
}

.settings-text-input
{
    width: 176dp;
    height: 36dp;
    background-color: #111214;
    border: 1dp #202024;
    border-radius: 4dp;
    color: #dbdee1;
    padding: 0 10dp;
    font-size: 14dp;
    box-sizing: border-box;
}

.settings-button-group
{
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 8dp;
    margin-top: 12dp;
}


/* Font override rows */

.settings-font-row
{
    display: flex;
    flex-direction: row;
    align-items: center;
    min-height: 48dp;
    padding: 6dp 0;
    border-bottom: 1dp #202024;
}

.settings-font-row:last-child
{
    border-bottom-width: 0;
}

.settings-font-name
{
    flex: 1;
    min-width: 0;
    font-size: 14dp;
    font-weight: 500;
    color: #dbdee1;
}

.settings-font-size
{
    font-size: 13dp;
    color: #949ba4;
    width: 56dp;
    flex-shrink: 0;
    text-align: right;
    margin-right: 12dp;
}

.settings-font-controls
{
    display: flex;
    flex-direction: row;
    align-items: center;
}

.settings-font-adjust
{
    width: 32dp;
    height: 32dp;
    padding: 0;
    margin-right: 6dp;
    font-size: 16dp;
}

.settings-font-reset
{
    min-width: 56dp;
    height: 32dp;
    padding: 0 10dp;
}

.settings-keybind
{
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	align-items: center;
	justify-content: space-between;
	gap: 8dp;
	background-color: #111214;
	border-radius: 4dp;
	padding: 8dp 8dp 8dp 12dp;
	margin-bottom: 12dp;
}

.settings-keybind-label
{
	font-size: 14dp;
	color: #dbdee1;
}

.settings-keybind-actions
{
	display: flex;
	flex-wrap: wrap;
	align-items: center;
	gap: 8dp;
}


.settings-keybind-error
{
	color: #f23f43;
	font-size: 13dp;
	margin-bottom: 12dp;
}

@media (max-width: 800dp)
{
	.settings-sidebar { width: 180dp; padding-left: 10dp; padding-right: 10dp; }
	.settings-content-wrapper { padding: 28dp 24dp 48dp 24dp; }
	.settings-close-container { top: 16dp; right: 16dp; }
}
