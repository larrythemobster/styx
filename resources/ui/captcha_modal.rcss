#captcha-modal-root
{
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 2000;
    display: none;
    background-color: transparent;
}

#captcha-modal-root.open
{
    display: block;
}

#captcha-open.disabled
{
    background-color: #4e5058;
    color: #b5bac1;
    cursor: default;
}
#captcha-modal-root button { tab-index: auto; }
#captcha-modal-root button:focus { background-color: #4752c4; color: #ffffff; }
#captcha-open.disabled { tab-index: none; }
