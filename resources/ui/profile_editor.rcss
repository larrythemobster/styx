.profile-editor-card {
    position: relative;
    width: 100%;
    height: 100%;
    background-color: transparent;
    border-width: 0;
    border-radius: 0;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    z-index: 0;
}

.profile-editor-header {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 0 0 8dp;
    box-sizing: border-box;
    flex-shrink: 0;
}


.profile-edit-state {
    font-size: 13dp;
    color: #949ba4;
    margin-left: 0;
}

.profile-editor-content {
    flex: 1;
    min-height: 0;
    overflow: hidden;
    padding: 0;
    box-sizing: border-box;
    display: flex;
    flex-direction: row;
}

.profile-edit-section {
    display: flex;
    flex-direction: column;
    margin-bottom: 16dp;
    flex-shrink: 0;
}

.profile-edit-label {
    font-size: 12dp;
    font-weight: 700;
    color: #b5bac1;
    text-transform: uppercase;
    margin-bottom: 8dp;
}

.profile-edit-banner-wrap {
    width: 100%;
    min-height: 120dp;
    background-color: #1e1f22;
    border: 1dp #202024;
    border-radius: 6dp;
    overflow: hidden;
    position: relative;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
}

.profile-edit-banner-img {
    width: 100%;
    height: auto;
    display: none;
}

.profile-edit-banner-note {
    font-size: 12dp;
    color: #949ba4;
    margin-top: 6dp;
    margin-bottom: 8dp;
}

.profile-edit-avatar-row {
    display: flex;
    flex-direction: row;
    align-items: center;
}

.profile-edit-avatar-wrap {
    width: 80dp;
    height: 80dp;
    border-radius: 40dp;
    background-color: #1e1f22;
    border: 1dp #202024;
    overflow: hidden;
    position: relative;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.profile-edit-avatar-img {
    width: 80dp;
    height: 80dp;
    border-radius: 40dp;
    display: block;
}

.profile-edit-unavailable {
    font-size: 12dp;
    color: #949ba4;
    text-align: center;
    padding: 4dp;
    box-sizing: border-box;
}

.profile-edit-avatar-btns {
    margin-left: 16dp;
    flex: 1;
    min-width: 0;
    flex-wrap: wrap;
}

.profile-edit-btn-row {
    display: flex;
    flex-direction: row;
    align-items: center;
}

.profile-edit-btn-row button {
    margin-right: 8dp;
}

.profile-edit-avatar-btns button {
    margin-bottom: 6dp;
}

.profile-edit-input {
    width: 100%;
    height: 40dp;
    background-color: #1e1f22;
    border: 1dp #202024;
    border-radius: 4dp;
    padding: 0 10dp;
    color: #dbdee1;
    font-size: 14dp;
    box-sizing: border-box;
}

.profile-edit-input:focus {
    border-color: #5865f2;
}

.profile-edit-input:disabled {
    opacity: 0.5;
    cursor: default;
}

.profile-edit-textarea {
    width: 100%;
    height: 80dp;
    background-color: #1e1f22;
    border: 1dp #202024;
    border-radius: 4dp;
    padding: 8dp 10dp;
    color: #dbdee1;
    font-size: 14dp;
    box-sizing: border-box;
    white-space: pre-wrap;
}

.profile-edit-textarea:focus {
    border-color: #5865f2;
}

.profile-edit-textarea:disabled {
    opacity: 0.5;
    cursor: default;
}

.profile-edit-error {
    font-size: 13dp;
    color: #f23f43;
    padding: 0 20dp 12dp 20dp;
    flex-shrink: 0;
    max-height: 100dp;
    overflow-y: auto;
}

.profile-editor-footer {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 16dp 0;
    border-top: 1dp #202024;
    box-sizing: border-box;
    flex-shrink: 0;
}

.profile-editor-footer-right {
    display: flex;
    flex-direction: row;
    align-items: center;
}

.profile-editor-card button {
    tab-index: auto;
    height: 40dp;
    padding: 0 14dp;
    border: 1dp #000000;
    line-height: 38dp;
    text-align: center;
    white-space: nowrap;
    font-size: 14dp;
    font-weight: 500;
    border-radius: 4dp;
    box-sizing: border-box;
    cursor: pointer;
    display: block;
}

.profile-editor-card button:disabled,
.profile-editor-card button.disabled {
    tab-index: none;
    focus: none;
    opacity: 0.5;
    cursor: default;
}

.profile-editor-card button:focus {
    border: 1dp #00a8fc;
}

.profile-editor-btn-primary {
    background-color: #5865f2;
    color: #ffffff;
}

.profile-editor-btn-primary:hover {
    background-color: #4752c4;
}

.profile-editor-btn-secondary {
    background-color: #4e5058;
    color: #ffffff;
}

.profile-editor-btn-secondary:hover {
    background-color: #6d6f78;
}

.profile-editor-footer-right button {
    margin-left: 8dp;
}

.profile-editor-layout { width: 100%; height: 100%; min-height: 0; display: flex; flex-direction: row; gap: 24dp; }
.profile-editor-fields { flex: 1; min-width: 0; min-height: 0; overflow-y: auto; padding-right: 12dp; box-sizing: border-box; }
.profile-editor-preview { width: 260dp; max-width: 42%; flex-shrink: 0; overflow-y: auto; }
.profile-live-card { border: 1dp #202024; border-radius: 8dp; background-color: #111214; overflow: hidden; }
.profile-live-banner { height: 90dp; overflow: hidden; background-color: #5865f2; }
.profile-live-banner img { width: 100%; }
.profile-live-avatar { position: relative; width: 88dp; height: 88dp; margin-top: -36dp; margin-left: 16dp; border: 6dp #111214; border-radius: 44dp; overflow: hidden; box-sizing: border-box; }
.profile-live-avatar img { width: 100%; height: 100%; }
.profile-live-details { padding: 12dp 16dp 20dp; }
.profile-live-name { font-size: 20dp; font-weight: 700; color: #f2f3f5; line-height: 26dp; }
.profile-live-username { font-size: 13dp; color: #dbdee1; margin-top: 4dp; }
.profile-live-pronouns { font-size: 12dp; color: #949ba4; margin-top: 4dp; }
.profile-live-about { margin-top: 16dp; padding-top: 16dp; border-top: 1dp #202024; }
#profile-live-bio { font-size: 13dp; line-height: 20dp; white-space: pre-wrap; word-break: break-word; }

@media (max-width: 1050dp)
{
    .profile-editor-preview { display: none; }
    .profile-editor-fields { padding-right: 0; }
}
