body#join-server-body {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: transparent;
    z-index: 200;
}

.join-server-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: #000000a0;
    z-index: 201;
}

.join-server-popover {
    position: absolute;
    top: 80dp;
    left: 50%;
    margin-left: -220dp;
    width: 440dp;
    background-color: #111214;
    border: 1dp #202024;
    border-radius: 8dp;
    padding: 20dp;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    z-index: 202;
}

.join-server-title {
    font-size: 20dp;
    font-weight: bold;
    color: #f2f3f5;
    text-align: center;
}

.join-server-subtitle {
    font-size: 14dp;
    color: #949ba4;
    text-align: center;
    margin-top: 8dp;
    margin-bottom: 16dp;
}

.join-server-input {
    width: 100%;
    height: 40dp;
    background-color: #1e1f22;
    border: 1dp #202024;
    border-radius: 4dp;
    padding: 0 8dp;
    color: #dbdee1;
    font-size: 16dp;
    box-sizing: border-box;
}

.join-server-input:focus {
    border-color: #5865f2;
}

.join-server-preview {
    display: flex;
    flex-direction: row;
    align-items: center;
    background-color: #1e1f22;
    border-radius: 8dp;
    padding: 12dp;
    margin-top: 12dp;
    box-sizing: border-box;
}

.join-server-icon {
    width: 48dp;
    height: 48dp;
    border-radius: 16dp;
    margin-right: 12dp;
    flex-shrink: 0;
}

.join-server-acronym {
    background-color: #2b2d31;
    color: #f2f3f5;
    font-size: 20dp;
    font-weight: bold;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
}

.join-server-info {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    flex-grow: 1;
}

.join-server-name {
    font-size: 16dp;
    font-weight: bold;
    color: #f2f3f5;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.join-server-counts {
    display: flex;
    flex-direction: row;
    align-items: center;
    font-size: 12dp;
    color: #949ba4;
    margin-top: 4dp;
}

.join-server-dot {
    width: 8dp;
    height: 8dp;
    border-radius: 4dp;
    background-color: #80848e;
    margin-right: 4dp;
    margin-left: 8dp;
    display: inline-block;
}

.join-server-dot:first-child {
    margin-left: 0;
}

.join-server-dot.online {
    background-color: #23a55a;
}

.join-server-meta {
    font-size: 12dp;
    color: #949ba4;
    margin-top: 4dp;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.join-server-error {
    font-size: 13dp;
    color: #f23f43;
    margin-top: 8dp;
}

.join-server-buttons {
    display: flex;
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    margin-top: 16dp;
}

.join-server-cancel {
    background-color: transparent;
    color: #dbdee1;
    font-size: 14dp;
    font-weight: 500;
    padding: 8dp 16dp;
    border-width: 0;
    cursor: pointer;
    margin-right: 8dp;
}

.join-server-cancel:hover {
    text-decoration: underline;
}

.join-server-confirm {
    background-color: #5865f2;
    color: #ffffff;
    font-size: 14dp;
    font-weight: 500;
    padding: 8dp 16dp;
    border-radius: 4dp;
    border-width: 0;
    cursor: pointer;
}

.join-server-confirm:hover {
    background-color: #4752c4;
}

.join-server-confirm:disabled {
    opacity: 0.5;
    cursor: default;
    background-color: #5865f2;
}
