body#create-group-dm-body {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    z-index: 1000;
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: transparent;
    box-sizing: border-box;
}

.create-group-dm-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: #000000b3;
    z-index: 1001;
}

#group-dm-card.group-dm-card {
    position: relative;
    width: 440dp;
    max-width: 90%;
    height: 480dp;
    max-height: 90%;
    background-color: #313338;
    border-radius: 8dp;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    z-index: 1002;
    overflow: hidden;
}

#group-dm-card button {
    tab-index: auto;
}

#group-dm-card button[disabled],
#group-dm-card input[disabled] {
    tab-index: none;
    focus: none;
}

.group-dm-header {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 16dp 20dp;
    flex-shrink: 0;
    border-bottom: 1dp #202024;
}

.group-dm-title {
    display: block;
    font-size: 20dp;
    font-weight: bold;
    color: #f2f3f5;
}

.group-dm-close {
    width: 40dp;
    height: 40dp;
    background-color: transparent;
    border-width: 0;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
}

.group-dm-close-icon {
    width: 18dp;
    height: 18dp;
    image-color: #b5bac1;
}

.group-dm-close:hover .group-dm-close-icon {
    image-color: #dbdee1;
}

.group-dm-content {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
    padding: 16dp 20dp 8dp 20dp;
    box-sizing: border-box;
}

.group-dm-context {
    display: block;
    font-size: 12dp;
    color: #b5bac1;
    margin-bottom: 12dp;
    flex-shrink: 0;
}

.group-dm-search-container {
    display: block;
    margin-bottom: 12dp;
    flex-shrink: 0;
}

.group-dm-search-label {
    display: block;
    font-size: 12dp;
    color: #b5bac1;
    margin-bottom: 6dp;
}

input.group-dm-search {
    display: block;
    width: 100%;
    height: 38dp;
    background-color: #1e1f22;
    border: 1dp #202024;
    border-radius: 4dp;
    padding: 0 10dp;
    color: #dbdee1;
    font-size: 14dp;
    box-sizing: border-box;
}

input.group-dm-search:focus {
    border-color: #5865f2;
}

input.group-dm-search[disabled] {
    cursor: default;
    color: #4e5058;
}

.group-dm-friends {
    display: block;
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    box-sizing: border-box;
}

.group-dm-friend {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    height: 44dp;
    padding: 6dp 8dp;
    margin-bottom: 2dp;
    border-radius: 4dp;
    border-width: 0;
    background-color: transparent;
    cursor: pointer;
    box-sizing: border-box;
    text-align: left;
}

.group-dm-friend:hover {
    background-color: #35373c;
}

.group-dm-friend.selected {
    background-color: #35373c;
}

.group-dm-friend:focus {
    border: 1dp #5865f2;
}

.group-dm-friend[disabled] {
    cursor: default;
    background-color: transparent;
}

.group-dm-friend[disabled]:hover {
    background-color: transparent;
}

.group-dm-friend-left {
    display: flex;
    flex-direction: row;
    align-items: center;
    min-width: 0;
    flex: 1;
}

.group-dm-friend-avatar {
    width: 32dp;
    height: 32dp;
    border-radius: 16dp;
    flex-shrink: 0;
}

.group-dm-friend-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
    margin-left: 10dp;
    overflow: hidden;
}

.group-dm-friend-name {
    display: block;
    white-space: nowrap;
    font-size: 14dp;
    font-weight: 500;
    color: #dbdee1;
}

.group-dm-friend-username {
    display: block;
    white-space: nowrap;
    font-size: 12dp;
    color: #949ba4;
}

.group-dm-friend[disabled] .group-dm-friend-name {
    color: #4e5058;
}

.group-dm-friend[disabled] .group-dm-friend-username {
    color: #4e5058;
}

.group-dm-friend[disabled] .group-dm-friend-avatar {
    image-color: #ffffff80;
}

.group-dm-checkbox {
    width: 20dp;
    height: 20dp;
    border: 1dp #80848e;
    border-radius: 4dp;
    background-color: transparent;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-sizing: border-box;
}

.group-dm-friend:hover .group-dm-checkbox {
    border-color: #dbdee1;
}

.group-dm-friend.selected .group-dm-checkbox {
    background-color: #5865f2;
    border-color: #5865f2;
}

.group-dm-check-icon {
    width: 14dp;
    height: 14dp;
    image-color: #ffffff;
    display: none;
}

.group-dm-friend.selected .group-dm-check-icon {
    display: block;
}

.group-dm-friend[disabled] .group-dm-checkbox {
    border-color: #4e5058;
}

.group-dm-friend.selected[disabled] .group-dm-checkbox {
    background-color: #5865f280;
    border-color: #5865f280;
}

.group-dm-no-results {
    display: block;
    padding: 24dp 0;
    text-align: center;
    color: #949ba4;
    font-size: 14dp;
}

.group-dm-footer {
    display: block;
    padding: 16dp 20dp;
    background-color: #2b2d31;
    flex-shrink: 0;
    box-sizing: border-box;
}

.group-dm-error {
    display: block;
    font-size: 13dp;
    color: #f23f43;
    margin-bottom: 8dp;
    word-break: break-word;
}

.group-dm-status {
    display: block;
    font-size: 13dp;
    color: #949ba4;
    margin-bottom: 8dp;
}

.group-dm-footer-bar {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.group-dm-count {
    display: block;
    font-size: 13dp;
    color: #949ba4;
}

.group-dm-footer-buttons {
    display: flex;
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
}

.group-dm-cancel {
    display: inline-block;
    background-color: transparent;
    color: #dbdee1;
    font-size: 14dp;
    font-weight: 500;
    padding: 8dp 16dp;
    border-width: 0;
    cursor: pointer;
    margin-right: 8dp;
}

.group-dm-cancel:hover {
    text-decoration: underline;
    color: #ffffff;
}

.group-dm-submit {
    display: inline-block;
    background-color: #5865f2;
    color: #ffffff;
    font-size: 14dp;
    font-weight: 500;
    padding: 8dp 20dp;
    border-radius: 4dp;
    border: 1dp transparent;
    cursor: pointer;
}

.group-dm-submit:hover {
    background-color: #4752c4;
}

.group-dm-submit[disabled] {
    background-color: #5865f280;
    color: #ffffff80;
    cursor: default;
}

.group-dm-close:focus,
.group-dm-cancel:focus {
    background-color: #35373c;
}

.group-dm-submit:focus {
    border-color: #f2f3f5;
}
