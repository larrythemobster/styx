#image-viewer-root
{
	position: absolute;
	top: 0;
	left: 0;
	width: 100%;
	height: 100%;
	z-index: 2500;
	display: none;
	background-color: transparent;
}

#image-viewer-root.open
{
	display: block;
}

.viewer-backdrop
{
	width: 100%;
	height: 100%;
	background-color: #000000d9;
	position: relative;
	overflow: hidden;
}

/* Toolbar */
.viewer-toolbar
{
	position: absolute;
	top: 0;
	left: 0;
	width: 100%;
	height: 52dp;
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
	padding: 0 20dp;
	box-sizing: border-box;
	z-index: 10;
}

.viewer-counter
{
	font-size: 14dp;
	color: #949ba4;
	display: none;
}

.viewer-counter.visible
{
	display: block;
}

.viewer-actions
{
	display: flex;
	flex-direction: row;
	align-items: center;
	margin-left: auto;
}

.viewer-btn
{
	background-color: #1e1f22;
	color: #f2f3f5;
	font-size: 13dp;
	font-weight: 500;
	padding: 6dp 12dp;
	border-radius: 4dp;
	border-width: 0;
	cursor: pointer;
	margin-left: 8dp;
}

.viewer-btn:hover
{
	background-color: #2b2d31;
}

.viewer-btn-close
{
	font-size: 14dp;
	font-weight: bold;
	padding: 4dp 10dp;
	background-color: transparent;
	color: #b5bac1;
}

.viewer-btn-close:hover
{
	background-color: #da373c;
	color: #ffffff;
}

/* Nav arrows */
.viewer-nav-btn
{
	position: absolute;
	top: 50%;
	transform: translateY(-50%);
	background-color: #00000080;
	color: #ffffff;
	font-size: 24dp;
	font-weight: bold;
	width: 48dp;
	height: 48dp;
	border-radius: 24dp;
	border-width: 0;
	cursor: pointer;
	z-index: 10;
	display: none;
	text-align: center;
	line-height: 44dp;
}

.viewer-nav-btn.visible
{
	display: block;
}

.viewer-nav-btn:hover
{
	background-color: #000000cc;
}

.viewer-nav-prev
{
	left: 20dp;
}

.viewer-nav-next
{
	right: 20dp;
}

/* Viewport & Image */
.viewer-viewport
{
	width: 100%;
	height: 100%;
	position: relative;
	overflow: hidden;
}

.viewer-image
{
	position: absolute;
	cursor: move;
	display: block;
}

/* Hint */
.viewer-hint
{
	position: absolute;
	bottom: 12dp;
	width: 100%;
	text-align: center;
	font-size: 12dp;
	color: #949ba480;
}
