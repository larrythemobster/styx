/* Forum view styling (Discord AMOLED dark) */

body#forum-body {
	position: absolute;
	left: 432dp;
	top: 0;
	right: 0;
	bottom: 0;
	background-color: #000000;
	display: flex;
	flex-direction: column;
	overflow: hidden;
	z-index: 30;
}

body.rail-folder-open#forum-body {
	left: 496dp;
}

#forum-header {
	height: 48dp;
	flex-shrink: 0;
	background-color: #000000;
	border-bottom: 1dp #202024;
	display: flex;
	flex-direction: row;
	align-items: center;
	padding: 0 16dp;
}

.forum-header-left {
	display: flex;
	flex-direction: row;
	align-items: center;
	flex: 1;
	min-width: 0;
}

.forum-header-icon {
	width: 20dp;
	height: 20dp;
	margin-right: 8dp;
	image-color: #949ba4;
}

.forum-header-title {
	font-size: 16dp;
	font-weight: bold;
	color: #f2f3f5;
	white-space: nowrap;
}

.forum-header-divider {
	width: 1dp;
	height: 16dp;
	background-color: #202024;
	margin: 0 12dp;
}

.forum-header-topic {
	font-size: 14dp;
	color: #949ba4;
	overflow: hidden;
	white-space: nowrap;
}

#forum-main {
	flex: 1;
	min-height: 0;
	display: flex;
	flex-direction: column;
	background-color: #000000;
}

#forum-controls {
	padding: 16dp 16dp 12dp 16dp;
	flex-shrink: 0;
	display: flex;
	flex-direction: column;
	border-bottom: 1dp #202024;
	background-color: #000000;
}

.forum-controls-row {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
}

.forum-sort-group {
	display: flex;
	flex-direction: row;
	align-items: center;
	background-color: #111214;
	border-radius: 4dp;
	padding: 2dp;
}

.forum-sort-pill {
	font-size: 13dp;
	color: #b5bac1;
	padding: 4dp 10dp;
	border-radius: 3dp;
	cursor: pointer;
}

.forum-sort-pill:hover {
	color: #dbdee1;
	background-color: #19191c;
}

.forum-sort-pill.active {
	color: #ffffff;
	background-color: #242428;
	font-weight: bold;
}

.forum-new-post-btn {
	display: flex;
	flex-direction: row;
	align-items: center;
	background-color: #5865f2;
	color: #ffffff;
	font-size: 14dp;
	font-weight: bold;
	padding: 6dp 14dp;
	border-radius: 4dp;
	cursor: pointer;
	border-width: 0;
}

.forum-new-post-btn:hover {
	background-color: #4752c4;
}

.forum-new-post-btn .btn-icon {
	width: 16dp;
	height: 16dp;
	margin-right: 6dp;
	image-color: #ffffff;
}

.forum-tags-bar {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	gap: 6dp;
	margin-top: 10dp;
}

.forum-tag-chip {
	font-size: 12dp;
	color: #b5bac1;
	background-color: #111214;
	border: 1dp #202024;
	border-radius: 12dp;
	padding: 4dp 10dp;
	cursor: pointer;
	display: flex;
	flex-direction: row;
	align-items: center;
}

.forum-tag-chip:hover {
	background-color: #19191c;
	color: #dbdee1;
	border-color: #35363c;
}

.forum-tag-chip.active {
	background-color: #5865f24d;
	border-color: #5865f2;
	color: #c9cdfb;
	font-weight: bold;
}

.forum-tag-chip .tag-emoji {
	width: 14dp;
	height: 14dp;
	margin-right: 4dp;
}

/* Composer */
.forum-composer {
	margin: 12dp 16dp;
	background-color: #0b0b0c;
	border: 1dp #202024;
	border-radius: 8dp;
	padding: 16dp;
	display: flex;
	flex-direction: column;
}

.composer-header {
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
	margin-bottom: 12dp;
}

.composer-title {
	font-size: 16dp;
	font-weight: bold;
	color: #f2f3f5;
}

.composer-close-btn {
	width: 24dp;
	height: 24dp;
	cursor: pointer;
	display: flex;
	align-items: center;
	justify-content: center;
}

.composer-close-btn img {
	width: 16dp;
	height: 16dp;
	image-color: #949ba4;
}

.composer-close-btn:hover img {
	image-color: #f2f3f5;
}

.composer-title-input {
	background-color: #111214;
	border: 1dp #202024;
	border-radius: 4dp;
	color: #dbdee1;
	font-size: 15dp;
	padding: 8dp 12dp;
	margin-bottom: 10dp;
	width: 100%;
	box-sizing: border-box;
}

.composer-tags-list {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	gap: 6dp;
	margin-bottom: 10dp;
}

.composer-body-input {
	background-color: #111214;
	border: 1dp #202024;
	border-radius: 4dp;
	color: #dbdee1;
	font-size: 14dp;
	padding: 8dp 12dp;
	height: 80dp;
	margin-bottom: 12dp;
	width: 100%;
	box-sizing: border-box;
}

.composer-footer {
	display: flex;
	flex-direction: row;
	justify-content: flex-end;
	gap: 8dp;
}

.composer-cancel-btn {
	background-color: transparent;
	color: #dbdee1;
	border: 1dp #202024;
	border-radius: 4dp;
	padding: 6dp 14dp;
	font-size: 14dp;
	cursor: pointer;
}

.composer-cancel-btn:hover {
	background-color: #19191c;
}

.composer-submit-btn {
	background-color: #5865f2;
	color: #ffffff;
	border-radius: 4dp;
	padding: 6dp 16dp;
	font-size: 14dp;
	font-weight: bold;
	border-width: 0;
	opacity: 0.5;
}

/* Scroll area and Post Cards */
#forum-scroll-area {
	flex: 1;
	min-height: 0;
	overflow-y: auto;
	padding: 12dp 16dp 24dp 16dp;
}

.forum-status-msg {
	text-align: center;
	color: #949ba4;
	font-size: 14dp;
	padding: 32dp 0;
}

.forum-posts-list {
	display: flex;
	flex-direction: column;
	gap: 8dp;
}

/* Post Card */
.forum-card {
	background-color: #0b0b0c;
	border: 1dp #202024;
	border-radius: 8dp;
	padding: 12dp 14dp;
	cursor: pointer;
	display: flex;
	flex-direction: row;
}

.forum-card:hover {
	background-color: #111214;
	border-color: #35363c;
}

.forum-card-left {
	flex: 1;
	min-width: 0;
	display: flex;
	flex-direction: column;
}

.forum-card-top-row {
	display: flex;
	flex-direction: row;
	align-items: center;
	margin-bottom: 4dp;
}

.forum-card-unread-dot {
	width: 8dp;
	height: 8dp;
	border-radius: 4dp;
	background-color: #5865f2;
	margin-right: 6dp;
	flex-shrink: 0;
}

.forum-card-title {
	font-size: 15dp;
	font-weight: bold;
	color: #f2f3f5;
	overflow: hidden;
	white-space: nowrap;
}

.forum-card-title.unread {
	color: #ffffff;
}

.forum-card-tags-row {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	gap: 4dp;
	margin-bottom: 6dp;
}

.forum-card-tag-pill {
	font-size: 11dp;
	color: #b5bac1;
	background-color: #19191c;
	border-radius: 8dp;
	padding: 2dp 8dp;
	display: flex;
	flex-direction: row;
	align-items: center;
}

.forum-card-tag-pill .tag-emoji {
	width: 12dp;
	height: 12dp;
	margin-right: 4dp;
}

.forum-card-snippet {
	font-size: 13dp;
	color: #949ba4;
	margin-bottom: 8dp;
	overflow: hidden;
	white-space: nowrap;
}

.forum-card-footer {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
}

.forum-card-meta-left {
	display: flex;
	flex-direction: row;
	align-items: center;
}

.forum-card-avatar {
	width: 18dp;
	height: 18dp;
	border-radius: 9dp;
	margin-right: 6dp;
}

.forum-card-author {
	font-size: 12dp;
	font-weight: bold;
	color: #dbdee1;
	margin-right: 8dp;
}

.forum-card-time {
	font-size: 12dp;
	color: #949ba4;
}

.forum-card-meta-right {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 10dp;
}

.forum-card-replies {
	display: flex;
	flex-direction: row;
	align-items: center;
	color: #949ba4;
	font-size: 12dp;
}

.forum-card-replies img {
	width: 14dp;
	height: 14dp;
	margin-right: 4dp;
	image-color: #949ba4;
}

.forum-card-thumbnail-container {
	width: 80dp;
	height: 80dp;
	margin-left: 14dp;
	flex-shrink: 0;
	border-radius: 6dp;
	overflow: hidden;
	background-color: #111214;
}

.forum-card-thumbnail {
	width: 80dp;
	height: 80dp;
}

.forum-load-more-row {
	display: flex;
	justify-content: center;
	padding: 16dp 0;
}

.forum-load-more-btn {
	background-color: #111214;
	color: #dbdee1;
	border: 1dp #202024;
	border-radius: 4dp;
	padding: 8dp 20dp;
	font-size: 14dp;
	cursor: pointer;
}

.forum-load-more-btn:hover {
	background-color: #19191c;
}
