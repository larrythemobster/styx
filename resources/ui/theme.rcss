/*
 * Discord's dark theme (2024 palette) and the app frame. Component styles live in their
 * own sheets (rail, channels, userpanel, chat, members, call), one per controller.
 *
 * Palette, for reference from the component sheets (RCSS has no variables):
 *   background tertiary (rail)        #000000
 *   background secondary (sidebar)    #0b0b0c
 *   background secondary alt (panel)  #08080a
 *   background primary (main/chat)    #000000
 *   background floating (menus)       #111214
 *   modifier hover                    #19191c
 *   modifier selected                 #242428
 *   input background                  #111214
 *   divider / border                  #202024
 *   text normal                       #dbdee1
 *   text muted                        #949ba4
 *   header primary                    #f2f3f5
 *   header secondary / interactive    #b5bac1
 *   interactive hover                 #dbdee1
 *   interactive muted                 #4e5058
 *   brand (blurple)                   #5865f2
 *   link                              #00a8fc
 *   green (online)                    #23a55a
 *   yellow (idle)                     #f0b232
 *   red (dnd, danger)                 #f23f43
 *   mention background / text         #5865f24d / #c9cdfb
 */

body
{
	width: 100%;
	height: 100%;
	font-family: ui;
	font-size: 16dp;
	color: #dbdee1;
	background-color: #000000;
	display: flex;
	flex-direction: column;
	overflow: hidden;
	position: relative;
}

/* --- frame ------------------------------------------------------------------------ */

#frame
{
	display: flex;
	flex-direction: row;
	flex: 1;
	min-height: 0;
	width: 100%;
}

#titlebar { display: none; }
body.custom-titlebar #titlebar
{
	display: flex;
	flex-direction: row;
	width: 100%;
	height: 28dp;
	flex-shrink: 0;
	background-color: #08080a;
	position: relative;
	z-index: 3000;
}
.titlebar-navigation { display: flex; width: 80dp; flex-shrink: 0; padding-left: 4dp; }
.titlebar-center
{
	position: absolute; left: 236dp; right: 236dp; height: 28dp;
	display: flex; align-items: center; justify-content: center;
	color: #b5bac1; font-size: 12dp; font-weight: 600;
	overflow: hidden; white-space: nowrap;
}
.titlebar-center img { width: 14dp; height: 14dp; margin-right: 6dp; image-color: #949ba4; }
.titlebar-app-actions { display: flex; flex-direction: row; margin-left: auto; flex-shrink: 0; }
.titlebar-action
{
	display: flex; align-items: center; justify-content: center;
	width: 32dp; height: 28dp; padding: 0; border-width: 0;
	background-color: transparent; color: #949ba4; font-size: 14dp; tab-index: auto;
}
.titlebar-action img { width: 16dp; height: 16dp; image-color: #949ba4; }
.titlebar-action:hover, .titlebar-action:focus { background-color: #303035; color: #f2f3f5; }
.titlebar-action:hover img, .titlebar-action:focus img { image-color: #f2f3f5; }
.titlebar-action.disabled img { image-color: #4e5058; }
.titlebar-action.available img { image-color: #23a55a; }
.titlebar-separator { width: 8dp; height: 16dp; box-sizing: border-box; margin-top: 6dp; border-right: 1dp #303035; }
.updates-backdrop { display: none; position: absolute; top: 28dp; left: 0; right: 0; bottom: 0; z-index: 2900; }
.updates-panel { position: absolute; right: 140dp; top: 4dp; width: 320dp; padding: 16dp; background-color: #111214; border: 1dp #303035; border-radius: 5dp; }
.updates-heading { color: #f2f3f5; font-size: 16dp; font-weight: 600; }
.updates-close { float: right; background-color: transparent; border-width: 0; color: #b5bac1; font-size: 20dp; tab-index: auto; }
.updates-detail { margin-top: 12dp; color: #b5bac1; font-size: 12dp; }
.updates-status { margin-top: 8dp; color: #dbdee1; font-size: 13dp; }
.updates-actions { display: flex; flex-direction: row; margin-top: 16dp; }
.updates-button { padding: 7dp 10dp; margin-right: 8dp; border-width: 0; border-radius: 3dp; background-color: #303035; color: #f2f3f5; font-size: 12dp; tab-index: auto; }
.updates-button:hover, .updates-button:focus { background-color: #48484e; }
.updates-primary { background-color: #5865f2; }
.updates-primary:hover, .updates-primary:focus { background-color: #4752c4; }
.titlebar-controls { display: flex; flex-direction: row; flex-shrink: 0; }
.titlebar-button
{
	display: flex;
	align-items: center;
	justify-content: center;
	width: 44dp;
	height: 28dp;
	padding: 0;
	border-width: 0;
	background-color: transparent;
	tab-index: auto;
}
.titlebar-button:hover, .titlebar-button:focus { background-color: #303035; }
.titlebar-close:hover, .titlebar-close:focus { background-color: #c42b1c; }
.titlebar-button:active { background-color: #48484e; }
.titlebar-close:active { background-color: #a82419; }
.titlebar-minimize-icon { width: 10dp; height: 1dp; background-color: #f2f3f5; }
.titlebar-maximize-icon { width: 10dp; height: 10dp; border: 1dp #f2f3f5; box-sizing: border-box; position: relative; }
.titlebar-restore-icon { display: none; }
.titlebar-button.maximized .titlebar-maximize-icon { width: 9dp; height: 8dp; margin-top: 3dp; margin-right: 3dp; }
.titlebar-button.maximized .titlebar-restore-icon
{
	display: block;
	position: absolute;
	width: 7dp;
	height: 6dp;
	top: -4dp;
	left: 2dp;
	border-top: 1dp #f2f3f5;
	border-right: 1dp #f2f3f5;
}
.titlebar-close-icon { width: 14dp; height: 14dp; image-color: #f2f3f5; }
#titlebar-hint
{
	display: none;
	position: absolute;
	box-sizing: content-box;
	padding: 6dp 8dp;
	background-color: #242428;
	color: #f2f3f5;
	font-size: 12dp;
	line-height: 16dp;
	white-space: nowrap;
	border-radius: 4dp;
	pointer-events: none;
	z-index: 3010;
}

#rail
{
	width: 72dp;
	height: 100%;
	flex-shrink: 0;
	background-color: #000000;
	display: flex;
	flex-direction: row;
}

body.rail-folder-open #rail
{
	width: 136dp;
}

#sidebar
{
	width: 240dp;
	height: 100%;
	flex-shrink: 0;
	background-color: #0b0b0c;
	display: flex;
	flex-direction: column;
	border-right: 1dp #202024;
	position: static;
    padding-bottom: 72dp;
    box-sizing: border-box;
}

#sidebar-header { height: 48dp; flex-shrink: 0; background-color: #0b0b0c; border-bottom: 1dp #202024; }
#channel-list { flex: 1; min-height: 0; overflow-y: auto; background-color: #0b0b0c; }
#voice-panel { flex-shrink: 0; background-color: #08080a; margin: 0 8dp 8dp 8dp; border: 1dp #202024; border-radius: 8dp; z-index: 90; }
body #user-panel
{
	position: absolute;
	left: 8dp;
	bottom: 8dp;
	width: 296dp;
	height: 56dp;
	border: 1dp #202024;
	border-radius: 8dp;
	background-color: #08080a;
	z-index: 100;
	box-sizing: border-box;
}

body.rail-folder-open #user-panel
{
	width: 360dp;
}
#main
{
	flex: 1;
	height: 100%;
	min-width: 0;
	background-color: #000000;
	display: flex;
	flex-direction: column;
}

#header
{
	height: 48dp;
	flex-shrink: 0;
	background-color: #000000;
	border-bottom: 1dp #202024;
}

#content
{
	flex: 1;
	min-height: 0;
	display: flex;
	flex-direction: row;
	background-color: #000000;
}

#chat
{
	flex: 1;
	min-width: 0;
	display: flex;
	flex-direction: column;
	background-color: #000000;
}

#messages { flex: 1; min-height: 0; overflow-y: auto; background-color: #000000; }
#typing { height: 24dp; flex-shrink: 0; }
#composer { flex-shrink: 0; }

#call
{
	flex: 1;
	min-width: 0;
	display: none;
	background-color: #000000;
}

#members
{
	width: 224dp;
	flex-shrink: 0;
	background-color: #0b0b0c;
	border-left: 1dp #202024;
	overflow-y: auto;
}

/* the chat gives way to the call view while a call is open; the member list hides */
body.call-open #chat { display: none; }
body.call-open #call { display: flex; }
body.call-open #members { display: none; }
body.members-hidden #members { display: none; }

/* friends sheet toggle */
body.friends-open #header { display: none; }
body.friends-open #chat { display: none; }
body.friends-open #members { display: none; }
body.friends-open #call { display: none; }

/* --- shared bits ------------------------------------------------------------------ */

img.emoji { width: 22dp; height: 22dp; vertical-align: -5dp; }
img.emoji.jumbo { width: 48dp; height: 48dp; }
img.icon { width: 20dp; height: 20dp; image-color: #b5bac1; }

.avatar { border-radius: 9999px; }

.status-online { background-color: #23a55a; }
.status-idle { background-color: #f0b232; }
.status-dnd { background-color: #f23f43; }
.status-offline { background-color: #80848e; }
.status-streaming { background-color: #593695; }

button
{
	display: inline-block;
	cursor: pointer;
}

.tooltip
{
	position: absolute;
	padding: 6dp 10dp;
	background-color: #111214;
	color: #dbdee1;
	font-size: 14dp;
	font-weight: 600;
	border-radius: 4dp;
	z-index: 100;
}
