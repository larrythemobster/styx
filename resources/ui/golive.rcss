body#golive-modal-body
{
	position: absolute;
	top: 0;
	left: 0;
	width: 100%;
	height: 100%;
	background-color: transparent;
	z-index: 2000;
	overflow: hidden;
}
.golive-backdrop
{
	width: 100%;
	height: 100%;
	background-color: #000000b2;
	display: flex;
	align-items: center;
	justify-content: center;
}
.golive-dialog
{
	position: relative;
	width: 960dp;
	max-width: 94%;
	height: 744dp;
	max-height: 92%;
	background-color: #111214;
	border: 1dp #202024;
	border-radius: 12dp;
	display: flex;
	flex-direction: column;
	box-sizing: border-box;
}
.golive-topbar
{
	display: flex;
	align-items: center;
	gap: 12dp;
	padding: 20dp 24dp 16dp;
	flex-shrink: 0;
}
.golive-tabs
{
	display: flex;
	flex: 1;
	padding: 3dp;
	background-color: #08080a;
	border: 1dp #000000;
	border-radius: 10dp;
}
.golive-tab-btn
{
	flex: 1;
	tab-index: auto;
	height: 36dp;
	padding: 0 12dp;
	border: 1dp transparent;
	border-radius: 7dp;
	background-color: transparent;
	color: #949ba4;
	font-size: 14dp;
	font-weight: 600;
	display: flex;
	align-items: center;
	justify-content: center;
	gap: 8dp;
	cursor: pointer;
}
.golive-tab-btn img
{
	width: 16dp;
	height: 16dp;
	image-color: #b5bac1;
}
.golive-tab-btn.active, .golive-tab-btn:hover, .golive-tab-btn:focus
{
	background-color: #19191c;
	border-color: #000000;
	color: #f2f3f5;
}
.golive-tab-btn:disabled, .golive-tab-btn.disabled
{
	tab-index: none;
	opacity: 0.45;
	cursor: default;
	background-color: transparent;
}
.golive-sources
{
	flex: 1;
	min-height: 0;
	margin: 0 8dp 0 20dp;
	padding: 2dp 12dp 2dp 2dp;
	overflow-y: auto;
	display: flex;
	flex-wrap: wrap;
	align-content: flex-start;
	gap: 16dp;
}
.golive-card
{
	width: 48.5%;
	box-sizing: border-box;
	border: 1dp transparent;
	border-radius: 10dp;
	padding: 3dp;
	cursor: pointer;
	tab-index: auto;
}
.golive-card:hover, .golive-card:focus, .golive-card.selected
{
	border-color: #4e5058;
}
.golive-thumb-wrap
{
	position: relative;
	width: 100%;
	height: 230dp;
	border: 1dp #000000;
	border-radius: 7dp;
	box-sizing: border-box;
	background-color: #08080a;
	display: flex;
	align-items: center;
	justify-content: center;
	overflow: hidden;
}
.golive-thumb-img
{
	max-width: 100%;
	max-height: 100%;
}
.golive-share-action
{
	position: absolute;
	tab-index: auto;
	left: 50%;
	top: 50%;
	transform: translate(-50%, -50%);
	min-width: 132dp;
	height: 40dp;
	padding: 0 20dp;
	background-color: #f2f3f5;
	color: #060607;
	border: 1dp #000000;
	border-radius: 8dp;
	font-size: 14dp;
	font-weight: 600;
	display: none;
	align-items: center;
	justify-content: center;
	cursor: pointer;
}
.golive-card:hover .golive-share-action, .golive-card:focus .golive-share-action,
.golive-card.selected .golive-share-action, .golive-share-action:focus
{
	display: flex;
}
.golive-share-action:disabled, .golive-share-action.disabled
{
	tab-index: none;
	opacity: 0.55;
	cursor: default;
}
.golive-card-title
{
	display: flex;
	align-items: center;
	gap: 8dp;
	height: 32dp;
	padding: 2dp;
	font-size: 14dp;
	font-weight: 600;
	color: #dbdee1;
}
.golive-card-title img
{
	width: 16dp;
	height: 16dp;
	image-color: #b5bac1;
	flex-shrink: 0;
}
.golive-card-title span
{
	white-space: nowrap;
	overflow: hidden;
}
.golive-empty
{
	width: 100%;
	height: 100%;
	display: flex;
	align-items: center;
	justify-content: center;
	color: #949ba4;
}
.golive-footer
{
	display: flex;
	align-items: center;
	gap: 20dp;
	padding: 16dp 24dp;
	flex-shrink: 0;
}
.golive-quality-summary
{
	flex-shrink: 0;
}
#golive-quality-mode
{
	font-size: 15dp;
	font-weight: 600;
	color: #dbdee1;
}
#golive-quality-detail
{
	margin-top: 3dp;
	font-size: 12dp;
	color: #949ba4;
}
.golive-status
{
	flex: 1;
	font-size: 12dp;
	color: #949ba4;
	text-align: right;
}
.golive-icon-button
{
	width: 40dp;
	tab-index: auto;
	height: 40dp;
	padding: 0;
	border: 1dp #000000;
	border-radius: 8dp;
	background-color: #232428;
	display: flex;
	align-items: center;
	justify-content: center;
	cursor: pointer;
	flex-shrink: 0;
}
.golive-icon-button img
{
	width: 20dp;
	height: 20dp;
	image-color: #dbdee1;
}
.golive-icon-button:hover, .golive-icon-button:focus, .golive-icon-button.active
{
	background-color: #35373c;
}
#golive-quality-menu
{
	display: none;
	position: absolute;
	right: 24dp;
	bottom: 72dp;
	width: 240dp;
	max-height: 80%;
	overflow-y: auto;
	padding: 8dp;
	background-color: #111214;
	border: 1dp #202024;
	border-radius: 8dp;
	z-index: 10;
}
#golive-quality-menu.open
{
	display: block;
}
.golive-menu-heading
{
	padding: 10dp 8dp 6dp;
	color: #949ba4;
	font-size: 13dp;
	font-weight: 600;
}
.golive-menu-row
{
	width: 100%;
	tab-index: auto;
	box-sizing: border-box;
	min-height: 40dp;
	padding: 9dp 8dp;
	border: 1dp transparent;
	border-radius: 5dp;
	background-color: transparent;
	color: #b5bac1;
	font-size: 14dp;
	font-weight: 500;
	display: flex;
	align-items: center;
	gap: 12dp;
	cursor: pointer;
	text-align: left;
}
.golive-menu-row:hover, .golive-menu-row:focus
{
	background-color: #232428;
	color: #f2f3f5;
	border-color: #000000;
}
.golive-menu-row:disabled, .golive-menu-row.disabled
{
	tab-index: none;
	background-color: transparent;
	border-color: transparent;
	opacity: 0.45;
	cursor: default;
}
.golive-menu-text
{
	flex: 1;
}
.golive-menu-description
{
	margin-top: 3dp;
	color: #949ba4;
	font-size: 12dp;
	font-weight: 400;
}
.golive-menu-separator
{
	height: 1dp;
	margin: 8dp 2dp;
	background-color: #202024;
}
.golive-menu-arrow
{
	width: 16dp;
	height: 16dp;
	image-color: #b5bac1;
	flex-shrink: 0;
}
.golive-radio, .golive-checkbox
{
	width: 20dp;
	height: 20dp;
	box-sizing: border-box;
	border: 1dp #80848e;
	border-radius: 10dp;
	flex-shrink: 0;
	display: flex;
	align-items: center;
	justify-content: center;
}
.golive-radio.checked
{
	background-color: #5865f2;
	border-color: #5865f2;
}
.golive-radio.checked div
{
	width: 8dp;
	height: 8dp;
	border-radius: 4dp;
	background-color: #ffffff;
}
.golive-checkbox
{
	border-radius: 4dp;
}
.golive-checkbox.checked
{
	background-color: #5865f2;
	border-color: #5865f2;
}
.golive-checkbox img
{
	width: 15dp;
	height: 15dp;
	image-color: #ffffff;
}
