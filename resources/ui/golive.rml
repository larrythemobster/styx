<rml>
<head>
	<title>Share your screen</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="theme.rcss"/>
	<link type="text/rcss" href="golive.rcss"/>
</head>
<body id="golive-modal-body">
	<div class="golive-backdrop" id="golive-backdrop">
		<div class="golive-dialog" id="golive-dialog">
			<div class="golive-topbar">
				<div class="golive-tabs">
					<button class="golive-tab-btn active" id="tab-applications" data-tab="applications"><img src="icon:monitor"/><span>Applications</span></button>
					<button class="golive-tab-btn" id="tab-screens" data-tab="screens"><img src="icon:monitor"/><span>Entire Screen</span></button>
					<button class="golive-tab-btn disabled" disabled="disabled" aria-disabled="true" title="Camera streaming is not available in Styx"><img src="icon:camera"/><span>Devices</span></button>
				</div>
				<button class="golive-icon-button" id="golive-close-btn" title="Close"><img src="icon:x"/></button>
			</div>
			<div class="golive-sources" id="golive-sources"></div>
			<div class="golive-footer">
				<div class="golive-quality-summary">
					<div id="golive-quality-mode">Custom</div>
					<div id="golive-quality-detail">720p · 30fps</div>
				</div>
				<div class="golive-status" id="golive-status"></div>
				<button class="golive-icon-button" id="golive-quality-button" title="Stream settings"><img src="icon:settings"/></button>
			</div>
			<div id="golive-quality-menu"></div>
		</div>
	</div>
</body>
</rml>
