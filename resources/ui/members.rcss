/* members.rcss - Discord member list styling */

#members {
    width: 224dp;
    flex-shrink: 0;
    background-color: #0b0b0c;
    overflow-y: auto;
    position: relative;
}

.members-scroll-area {
    position: relative;
    width: 100%;
}

.member-item {
    position: absolute;
    left: 8dp;
    right: 8dp;
    box-sizing: border-box;
}

/* Group Headers */
.member-group-header {
    height: 40dp;
    padding-top: 20dp;
    padding-left: 8dp;
    padding-right: 8dp;
    font-size: 12dp;
    font-weight: 600;
    color: #949ba4;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    white-space: nowrap;
    overflow: hidden;
    box-sizing: border-box;
}

/* Member Rows */
.member-row {
    height: 42dp;
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 0 8dp;
    border-radius: 6dp;
    cursor: pointer;
    box-sizing: border-box;
}

.member-row:hover {
    background-color: #19191c;
}

.member-row.offline {
    opacity: 0.35;
}

.member-avatar-wrap {
    width: 32dp;
    height: 32dp;
    position: relative;
    flex-shrink: 0;
    margin-right: 12dp;
}

.member-avatar-clip {
    width: 32dp;
    height: 32dp;
    border-radius: 16dp;
    overflow: hidden;
}

.member-avatar {
    width: 32dp;
    height: 32dp;
    display: block;
}

.member-avatar-fallback {
    width: 32dp;
    height: 32dp;
    border-radius: 16dp;
    background-color: #19191c;
    color: #dbdee1;
    font-size: 13dp;
    font-weight: 600;
    text-align: center;
    line-height: 32dp;
}

.member-status-dot {
    position: absolute;
    width: 10dp;
    height: 10dp;
    bottom: -2dp;
    right: -2dp;
    border-radius: 5dp;
    border: 2dp #0b0b0c;
    box-sizing: content-box;
    clip: 1;
}

.member-row:hover .member-status-dot {
    border-color: #19191c;
}

.member-content {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
}

.member-name-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    min-width: 0;
}

.member-name {
    font-size: 15dp;
    font-weight: 500;
    color: #dbdee1;
    white-space: nowrap;
    overflow: hidden;
    flex-shrink: 1;
}

.member-crown {
    width: 14dp;
    height: 14dp;
    margin-left: 4dp;
    image-color: #f0b232;
    flex-shrink: 0;
}

.member-activity {
    font-size: 11dp;
    color: #949ba4;
    white-space: nowrap;
    overflow: hidden;
    margin-top: 1dp;
}

/* 1:1 DM Profile Panel */
.dm-profile-panel {
    display: flex;
    flex-direction: column;
    width: 100%;
    min-height: 100%;
    box-sizing: border-box;
}

body.rail-folder-open #user-panel {
    width: 360dp;
}

.dm-profile-banner {
    width: 100%;
    height: 72dp;
    background-color: #19191c;
}

.dm-profile-body {
    position: relative;
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
    padding: 0 16dp 16dp 16dp;
    flex: 1;
    display: flex;
    flex-direction: column;
}

.dm-profile-avatar-wrap {
    width: 80dp;
    height: 80dp;
    position: relative;
    margin-top: -40dp;
    margin-bottom: 8dp;
}

.dm-profile-avatar-clip {
    width: 80dp;
    height: 80dp;
    border-radius: 40dp;
    overflow: hidden;
    border: 6dp #0b0b0c;
    box-sizing: content-box;
}

.dm-profile-avatar {
    width: 80dp;
    height: 80dp;
    display: block;
}

.dm-profile-avatar-fallback {
    width: 80dp;
    height: 80dp;
    border-radius: 40dp;
    border: 6dp #0b0b0c;
    background-color: #19191c;
    color: #dbdee1;
    font-size: 32dp;
    font-weight: 600;
    text-align: center;
    line-height: 80dp;
    box-sizing: content-box;
}

.dm-profile-status-dot {
    position: absolute;
    width: 16dp;
    height: 16dp;
    bottom: 2dp;
    right: 2dp;
    border-radius: 8dp;
    border: 4dp #0b0b0c;
    box-sizing: content-box;
    clip: 1;
}

.dm-profile-display-name {
    font-size: 18dp;
    font-weight: 700;
    color: #f2f3f5;
    white-space: nowrap;
    overflow: hidden;
}

.dm-profile-username {
    font-size: 14dp;
    color: #949ba4;
    margin-top: 2dp;
}

.dm-profile-divider {
    height: 1dp;
    background-color: #202024;
    margin: 12dp 0;
}

.dm-profile-section-title {
    font-size: 12dp;
    font-weight: 700;
    color: #b5bac1;
    text-transform: uppercase;
    margin-bottom: 8dp;
}

.dm-profile-activity {
    font-size: 13dp;
    color: #dbdee1;
    line-height: 18dp;
}

.dm-profile-view {
    tab-index: auto;
    width: 100%;
    box-sizing: border-box;
    display: block;
    text-align: center;
    line-height: 38dp;
    flex-shrink: 0;
    min-height: 40dp;
    margin-top: auto;
    padding: 0 8dp;
    border: 1dp #303036;
    border-radius: 6dp;
    background-color: #242428;
    color: #dbdee1;
    font-size: 13dp;
    font-weight: 600;
    cursor: pointer;
}

.dm-profile-view:hover, .dm-profile-view:focus {
    background-color: #303036;
    color: #ffffff;
}
