#voice-panel
{
	width: 100%;
	box-sizing: border-box;
	margin: 0 0 -1dp 0;
	padding: 8dp;
	background-color: #08080a;
	border: 1dp #202024;
	border-radius: 8dp 8dp 0 0;
	display: flex;
	flex-direction: column;
	flex-shrink: 0;
	gap: 8dp;
}
body.voice-connected #user-panel
{
	border-top-width: 0;
	border-top-left-radius: 0;
	border-top-right-radius: 0;
}
.voice-panel-header
{
	display: flex;
	align-items: center;
	gap: 6dp;
}
.voice-status-badge
{
	width: 30dp;
	height: 30dp;
	border: 1dp #202024;
	border-radius: 5dp;
	display: flex;
	align-items: center;
	justify-content: center;
	flex-shrink: 0;
}
.voice-status-badge img
{
	width: 20dp;
	height: 20dp;
	image-color: #23a55a;
}
.voice-connection-text
{
	flex: 1;
	min-width: 0;
	cursor: pointer;
}
.voice-conn-status
{
	font-size: 14dp;
	font-weight: 600;
	line-height: 18dp;
	color: #23a55a;
}
.voice-conn-status.connecting
{
	color: #faa61a;
}
.voice-channel-link
{
	font-size: 12dp;
	line-height: 16dp;
	color: #b5bac1;
	white-space: nowrap;
	overflow: hidden;
}
.voice-connection-text:hover .voice-channel-link
{
	color: #dbdee1;
}
.voice-header-btn
{
	width: 28dp;
	tab-index: auto;
	height: 32dp;
	padding: 0;
	background-color: transparent;
	border-width: 0;
	border-radius: 4dp;
	display: flex;
	align-items: center;
	justify-content: center;
	flex-shrink: 0;
	cursor: pointer;
}
.voice-header-btn img
{
	width: 18dp;
	height: 18dp;
	image-color: #b5bac1;
}
.voice-header-btn:hover, .voice-header-btn:focus
{
	background-color: #232428;
}
.voice-header-btn.disconnect:hover
{
	background-color: #f23f43;
}
.voice-header-btn.disconnect:hover img
{
	image-color: #ffffff;
}
.voice-panel-actions
{
	display: flex;
	gap: 8dp;
}
.voice-action-btn
{
	flex: 1;
	tab-index: auto;
	height: 34dp;
	padding: 0;
	box-sizing: border-box;
	border: 1dp #000000;
	border-radius: 6dp;
	display: flex;
	align-items: center;
	justify-content: center;
	background-color: #111214;
	cursor: pointer;
}
.voice-action-btn:hover, .voice-action-btn:focus
{
	background-color: #232428;
}
.voice-action-btn img
{
	width: 20dp;
	height: 20dp;
	image-color: #dbdee1;
}
.voice-action-btn:disabled, .voice-action-btn.disabled
{
	tab-index: none;
	opacity: 0.45;
	cursor: default;
	background-color: #111214;
}
.voice-action-btn.streaming
{
	background-color: #23a55a;
}
.voice-action-btn.streaming img
{
	image-color: #ffffff;
}

/* User Panel */
#user-panel
{
	position: relative;
	width: 100%;
	height: 56dp;
	border: 1dp #202024;
	border-radius: 8dp;
	background-color: #08080a;
	padding: 0 8dp;
	display: flex;
	align-items: center;
	box-sizing: border-box;
	z-index: 100;
}


.user-panel-info
{
	display: flex;
	align-items: center;
	flex: 1;
	min-width: 0;
	height: 40dp;
	cursor: pointer;
	border-radius: 4dp;
	padding: 0 4dp;
	margin-right: 4dp;
	transition: background-color 0.15s;
}

.user-panel-info:hover
{
	background-color: #19191c;
}

.user-avatar-wrap
{
	position: relative;
	width: 32dp;
	height: 32dp;
	margin-right: 8dp;
	flex-shrink: 0;
}
.user-avatar-clip
{
	width: 32dp;
	height: 32dp;
	border-radius: 16dp;
	overflow: hidden;
}

.user-avatar
{
	width: 32dp;
	height: 32dp;
	display: block;
}

.user-avatar-wrap .status-dot
{
	position: absolute;
	right: -2dp;
	bottom: -2dp;
	width: 10dp;
	height: 10dp;
	border-radius: 5dp;
	border: 2dp #08080a;
	clip: 1;
}

.user-speaking-ring
{
	display: none;
	position: absolute;
	left: -3dp;
	top: -3dp;
	width: 38dp;
	height: 38dp;
	box-sizing: border-box;
	border: 2dp #23a55a;
	border-radius: 19dp;
	pointer-events: none;
}

.user-avatar-wrap.speaking .user-speaking-ring
{
	display: block;
}

.user-names
{
	display: flex;
	flex-direction: column;
	overflow: hidden;
	min-width: 0;
	flex: 1;
}

.user-display-name
{
	font-size: 14dp;
	font-weight: 600;
	color: #f2f3f5;
	overflow: hidden;
	white-space: nowrap;
	line-height: 18dp;
}

.user-sub-name
{
	display: flex;
	flex-direction: row;
	align-items: center;
	font-size: 12dp;
	color: #b5bac1;
	overflow: hidden;
	white-space: nowrap;
	line-height: 14dp;
}

.user-status-emoji
{
	width: 14dp;
	height: 14dp;
	margin-right: 4dp;
	flex-shrink: 0;
	display: inline-block;
}

.user-status-text
{
	overflow: hidden;
	white-space: nowrap;
}

.user-panel-buttons
{
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 2dp;
	flex-shrink: 0;
}

.panel-btn
{
	width: 32dp;
	height: 32dp;
	border-radius: 4dp;
	display: flex;
	align-items: center;
	justify-content: center;
	cursor: pointer;
	transition: background-color 0.15s;
}

.panel-btn:hover
{
	background-color: #19191c;
}

.panel-btn img
{
	width: 20dp;
	height: 20dp;
	image-color: #b5bac1;
	transition: image-color 0.15s;
}

.panel-btn:hover img
{
	image-color: #dbdee1;
}

.panel-btn.active img,
.panel-btn.muted img,
.panel-btn.deafened img
{
	image-color: #f23f43;
}

.custom-status-btn
{
	tab-index: auto;
	width: 40dp;
	height: 40dp;
	padding: 0;
	border-width: 0;
	background-color: transparent;
}

.custom-status-btn:focus
{
	background-color: #19191c;
}

.custom-status-btn:focus img
{
	image-color: #dbdee1;
}
