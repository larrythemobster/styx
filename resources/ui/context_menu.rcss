#context-menu-root {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: block;
    background-color: transparent;
    z-index: 2100;
}
.context-menu-panel {
    position: absolute;
    z-index: 0;
    width: 224dp;
    max-width: 96%;
    max-height: 96%;
    overflow-y: auto;
    padding: 6dp;
    box-sizing: border-box;
    background-color: #111214;
    border: 1dp #303136;
    border-radius: 8dp;
}
.menu-item {
    display: flex;
    align-items: center;
    width: 100%;
    min-height: 32dp;
    padding: 8dp;
    box-sizing: border-box;
    border-width: 0;
    border-radius: 3dp;
    color: #dbdee1;
    background-color: transparent;
    text-align: left;
    cursor: pointer;
    font-size: 14dp;
}
.menu-item:hover, .menu-item:focus, .menu-item.submenu-open {
    background-color: #35363c;
    color: #ffffff;
}
.menu-item.danger { color: #ff7378; }
.menu-item.danger:hover, .menu-item.danger:focus { background-color: #a12828; color: #ffffff; }
.menu-item.disabled { color: #949ba4; background-color: transparent; cursor: default; }
.menu-label { cursor: default; }
.menu-text { flex: 1; min-width: 0; word-break: break-all; }
.menu-subtitle { color: #b5bac1; font-size: 12dp; margin-top: 3dp; }
.menu-avatar { width: 48dp; height: 48dp; border-radius: 24dp; margin-right: 10dp; flex-shrink: 0; }
.menu-arrow { margin-left: 10dp; }
.menu-separator { height: 1dp; background-color: #303136; margin: 4dp; }
.menu-check {
    width: 18dp;
    height: 18dp;
    margin-left: 12dp;
    border: 1dp #949ba4;
    border-radius: 4dp;
    box-sizing: border-box;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    font-size: 14dp;
}
.menu-check.checked { background-color: #5865f2; border-color: #5865f2; }
.menu-check.radio { border-radius: 9dp; }
.menu-check-mark { font-family: symbols; line-height: 16dp; }
.menu-radio-dot { width: 8dp; height: 8dp; background-color: #ffffff; border-radius: 4dp; }
.menu-check-mark, .menu-radio-dot { visibility: hidden; }
.menu-check.checked .menu-check-mark, .menu-check.checked .menu-radio-dot { visibility: visible; }
.menu-icon-text {
    width: 17dp;
    height: 16dp;
    margin-right: 9dp;
    border-radius: 3dp;
    background-color: #949ba4;
    color: #111214;
    font-size: 10dp;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}
