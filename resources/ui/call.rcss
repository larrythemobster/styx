/* Discord call view */

#call {
    width: 100%;
    height: 100%;
    background-color: #000000;
    display: none;
    flex-direction: column;
    position: relative;
    overflow: hidden;
}

body.call-open #call {
    display: flex;
}

body.call-open #header { display: none; }

.call-header-btn,
.call-btn,
.call-btn-disconnect,
.call-watch-btn,
.call-stop-watch-btn {
    tab-index: auto;
}

.call-header-btn:focus,
.call-btn:focus,
.call-watch-btn:focus,
.call-stop-watch-btn:focus {
    background-color: #303034;
}

.call-btn-disconnect:focus {
    background-color: #f23f43;
}

.call-header {
    min-height: 56dp;
    flex-shrink: 0;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 0 20dp;
    background-color: #08080a;
    border-bottom: 1dp #202024;
    z-index: 10;
}

.call-header-left {
    display: flex;
    flex-direction: row;
    align-items: center;
    min-width: 0;
}

.call-header-icon {
    width: 20dp;
    height: 20dp;
    image-color: #949ba4;
    margin-right: 10dp;
    flex-shrink: 0;
}

.call-header-heading {
    display: flex;
    flex-direction: column;
    min-width: 0;
}

.call-header-title {
    font-size: 15dp;
    font-weight: 600;
    color: #f2f3f5;
    white-space: nowrap;
    overflow: hidden;
}

.call-header-status {
    font-size: 11dp;
    color: #23a55a;
    margin-top: 1dp;
}

.call-header-right {
    display: flex;
    flex-direction: row;
    align-items: center;
}

.call-header-btn {
    width: 40dp;
    height: 40dp;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: transparent;
    border-width: 0;
    border-radius: 6dp;
    cursor: pointer;
    margin-left: 6dp;
}

.call-header-btn:hover {
    background-color: #19191c;
}

.call-header-btn img {
    width: 20dp;
    height: 20dp;
    image-color: #b5bac1;
}

.call-header-btn:hover img {
    image-color: #dbdee1;
}

.call-body {
    flex: 1;
    min-height: 0;
    padding: 24dp;
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
}

.call-grid {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-content: center;
    justify-content: center;
    padding: 8dp;
    box-sizing: border-box;
}

.call-grid.tiles-1 .call-tile {
    width: 82%;
    height: 82%;
    max-width: 1040dp;
    max-height: 600dp;
}

.call-grid.tiles-2 .call-tile {
    width: 46%;
    height: 72%;
    max-width: 620dp;
    max-height: 440dp;
    margin: 8dp;
}

.call-grid.tiles-3 .call-tile,
.call-grid.tiles-4 .call-tile {
    width: 46%;
    height: 44%;
    max-width: 560dp;
    max-height: 340dp;
    margin: 8dp;
}

.call-grid.tiles-5 .call-tile,
.call-grid.tiles-6 .call-tile,
.call-grid.tiles-more .call-tile {
    width: 30%;
    height: 44%;
    max-width: 440dp;
    max-height: 300dp;
    margin: 6dp;
}
.call-focus-view {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
}

.call-focus-main {
    flex: 1;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
}

.call-focus-main .call-tile {
    width: 100%;
    height: 100%;
    margin: 0;
}

.call-focus-strip {
    height: 110dp;
    flex-shrink: 0;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    overflow-x: auto;
    margin-top: 12dp;
}

.call-focus-strip .call-tile {
    width: 160dp;
    height: 90dp;
    margin: 0 6dp;
    flex-shrink: 0;
}

.call-tile {
    background-color: #111214;
    border-radius: 10dp;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-sizing: border-box;
    border: 3dp transparent;
    transition: background-color 0.12s;
}

.call-tile.speaking {
    border: 3dp #23a55a;
}

.call-tile-avatar-center {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 80dp;
    height: 80dp;
    border-radius: 40dp;
    overflow: hidden;
}

.call-focus-strip .call-tile-avatar-center {
    width: 48dp;
    height: 48dp;
    border-radius: 24dp;
}

.call-tile-avatar {
    width: 80dp;
    height: 80dp;
    display: block;
}

.call-focus-strip .call-tile-avatar {
    width: 48dp;
    height: 48dp;
}

.call-tile-avatar-fallback {
    width: 80dp;
    height: 80dp;
    border-radius: 40dp;
    background-color: #19191c;
    color: #dbdee1;
    font-size: 32dp;
    font-weight: 600;
    text-align: center;
    line-height: 80dp;
}

.call-focus-strip .call-tile-avatar-fallback {
    width: 48dp;
    height: 48dp;
    border-radius: 24dp;
    font-size: 20dp;
    line-height: 48dp;
}

.call-video-frame {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    display: block;
    background-color: #000000;
}

.call-tile-pill {
    position: absolute;
    bottom: 10dp;
    left: 10dp;
    min-height: 30dp;
    background-color: #000000b3;
    border-radius: 6dp;
    padding: 0 10dp;
    display: flex;
    flex-direction: row;
    align-items: center;
    z-index: 5;
}

.call-tile-name {
    font-size: 13dp;
    font-weight: 500;
    color: #f2f3f5;
    white-space: nowrap;
    overflow: hidden;
    max-width: 180dp;
}

.call-tile-icons {
    display: flex;
    flex-direction: row;
    align-items: center;
    margin-left: 6dp;
}

.call-tile-icon {
    width: 14dp;
    height: 14dp;
    image-color: #f23f43;
    margin-left: 4dp;
}

.call-badge-live {
    position: absolute;
    top: 12dp;
    left: 12dp;
    background-color: #f23f43;
    color: #ffffff;
    font-size: 11dp;
    font-weight: 700;
    padding: 3dp 7dp;
    border-radius: 4dp;
    letter-spacing: 0.5px;
    z-index: 5;
}

.call-self-preview-text {
    position: absolute;
    color: #949ba4;
    font-size: 13dp;
    font-weight: 500;
    bottom: 48dp;
    text-align: center;
    z-index: 5;
}

.call-controls {
    min-height: 96dp;
    flex-shrink: 0;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: #08080a;
    border-top: 1dp #202024;
    z-index: 10;
    padding: 10dp 12dp;
    box-sizing: border-box;
}

.call-control-group {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 6dp;
    border-radius: 12dp;
    background-color: #111214;
    margin-right: 10dp;
}

.call-btn {
    min-width: 64dp;
    height: 60dp;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: transparent;
    color: #dbdee1;
    border-width: 0;
    border-radius: 8dp;
    cursor: pointer;
    margin: 0 2dp;
    padding: 4dp 6dp;
}

.call-btn:hover {
    background-color: #242428;
}

.call-btn img {
    width: 22dp;
    height: 22dp;
    image-color: #dbdee1;
}

.call-btn span {
    font-size: 11dp;
    color: #b5bac1;
    margin-top: 4dp;
}

.call-btn.active {
    background-color: #da373c;
}

.call-btn.active img,
.call-btn.active span {
    image-color: #ffffff;
    color: #ffffff;
}

.call-btn.active:hover {
    background-color: #f23f43;
}

.call-btn-disconnect {
    min-width: 108dp;
    height: 60dp;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: #da373c;
    color: #ffffff;
    border-width: 0;
    border-radius: 8dp;
    cursor: pointer;
    padding: 0 12dp;
}

.call-btn-disconnect:hover {
    background-color: #f23f43;
}

.call-btn-disconnect img {
    width: 20dp;
    height: 20dp;
    image-color: #ffffff;
    margin-right: 8dp;
}

.call-btn-disconnect span {
    font-size: 13dp;
    font-weight: 600;
    color: #ffffff;
}

.call-empty {
    width: 82%;
    height: 76%;
    max-width: 1040dp;
    max-height: 540dp;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: #111214;
    border: 1dp #202024;
    border-radius: 12dp;
}

.call-empty-title {
    font-size: 20dp;
    font-weight: 600;
    color: #f2f3f5;
    margin-bottom: 6dp;
}

.call-empty-description {
    font-size: 13dp;
    color: #949ba4;
}

.call-watch-btn {
    position: absolute;
    top: 12dp;
    right: 12dp;
    z-index: 6;
    min-height: 40dp;
    background-color: #5865f2;
    color: #ffffff;
    border-width: 0;
    border-radius: 6dp;
    padding: 0 14dp;
    font-size: 13dp;
    font-weight: 600;
    cursor: pointer;
}

.call-watch-btn:hover {
    background-color: #4752c4;
}

.call-stop-watch-btn {
    position: absolute;
    top: 10dp;
    right: 10dp;
    z-index: 7;
    min-height: 40dp;
    background-color: #19191c;
    color: #ffffff;
    border-width: 0;
    border-radius: 6dp;
    padding: 0 12dp;
    font-size: 12dp;
    cursor: pointer;
}

.call-stop-watch-btn:hover {
    background-color: #da373c;
}
