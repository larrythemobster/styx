#user-profile-root
{
	position: absolute;
	top: 0;
	left: 0;
	width: 100%;
	height: 100%;
	z-index: 1500;
	display: none;
	background-color: transparent;
}

#user-profile-root.open
{
	display: block;
}

.profile-backdrop
{
	width: 100%;
	height: 100%;
	background-color: transparent;
	position: relative;
}

.profile-card
{
	position: absolute;
	width: 320dp;
	background-color: #232428;
	border-radius: 8dp;
	overflow: hidden;
	display: flex;
	flex-direction: column;
}

/* Banner */
.profile-banner
{
	width: 100%;
	height: 105dp;
	background-color: #5865f2;
	position: relative;
	overflow: hidden;
}

.profile-more-btn
{
	position: absolute;
	top: 8dp;
	right: 8dp;
	width: 28dp;
	height: 28dp;
	border-radius: 14dp;
	background-color: #00000080;
	display: flex;
	align-items: center;
	justify-content: center;
	cursor: pointer;
}

.profile-more-btn img
{
	width: 16dp;
	height: 16dp;
	image-color: #f2f3f5;
}

.profile-more-btn:hover
{
	background-color: #000000c0;
}

.profile-banner-img
{
	width: 100%;
	height: 100%;
	display: none;
}

.profile-banner-img.visible
{
	display: block;
}

/* Header with Avatar overlapping banner */
.profile-header
{
	position: relative;
	height: 48dp;
	padding: 0 16dp;
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	align-items: flex-end;
}

.profile-avatar-wrapper
{
	position: absolute;
	top: -46dp;
	left: 16dp;
	width: 80dp;
	height: 80dp;
	border-radius: 40dp;
	background-color: #232428;
	padding: 6dp;
	box-sizing: border-box;
}

.profile-avatar-img
{
	width: 68dp;
	height: 68dp;
	border-radius: 34dp;
	display: block;
}

.profile-status-dot
{
	position: absolute;
	bottom: 4dp;
	right: 4dp;
	width: 16dp;
	height: 16dp;
	border-radius: 8dp;
	background-color: #80848e;
	border: 3dp #232428;
	box-sizing: content-box;
}

.profile-status-dot.online { background-color: #23a55a; }
.profile-status-dot.idle { background-color: #f0b232; }
.profile-status-dot.dnd { background-color: #f23f43; }
.profile-status-dot.offline { background-color: #80848e; }
.profile-status-dot.streaming { background-color: #593695; }

.profile-badges
{
	margin-left: auto;
	margin-bottom: 8dp;
	display: flex;
	flex-direction: row;
	background-color: #111214;
	border-radius: 4dp;
	padding: 2dp 4dp;
}

.profile-badge-icon
{
	width: 18dp;
	height: 18dp;
	margin: 0 2dp;
}

/* Body */
.profile-body
{
	margin: 0 12dp 12dp 12dp;
	padding: 12dp;
	background-color: #111214;
	border-radius: 8dp;
	display: flex;
	flex-direction: column;
}

.profile-identity
{
	margin-bottom: 6dp;
}

.profile-names-row
{
	display: flex;
	flex-direction: row;
	align-items: center;
}

.profile-display-name
{
	font-size: 18dp;
	font-weight: bold;
	color: #f2f3f5;
	line-height: 22dp;
}

.profile-bot-badge
{
	background-color: #5865f2;
	color: #ffffff;
	font-size: 9dp;
	font-weight: bold;
	padding: 1dp 4dp;
	border-radius: 3dp;
	margin-left: 6dp;
	display: none;
}

.profile-bot-badge.visible
{
	display: inline-block;
}

.profile-handle
{
	font-size: 13dp;
	color: #949ba4;
	line-height: 16dp;
}

.profile-pronouns
{
	font-size: 12dp;
	color: #949ba4;
	margin-top: 2dp;
	display: none;
}

.profile-pronouns.visible
{
	display: block;
}

/* Custom Status */
.profile-custom-status
{
	display: none;
	flex-direction: row;
	align-items: center;
	margin-top: 6dp;
	font-size: 13dp;
	color: #dbdee1;
}

.profile-custom-status.visible
{
	display: flex;
}

.profile-status-emoji
{
	width: 18dp;
	height: 18dp;
	margin-right: 6dp;
}

.profile-divider
{
	height: 1dp;
	background-color: #202024;
	margin: 10dp 0;
}

.profile-scroll
{
	max-height: 260dp;
	overflow-y: auto;
}

.profile-section
{
	margin-bottom: 12dp;
}

.profile-section-title
{
	font-size: 11dp;
	font-weight: bold;
	color: #b5bac1;
	text-transform: uppercase;
	margin-bottom: 6dp;
	letter-spacing: 0.5dp;
}

.profile-bio-text
{
	font-size: 13dp;
	line-height: 18dp;
	color: #dbdee1;
	white-space: pre-wrap;
}

/* Activity card */
.activity-card
{
	background-color: #1e1f22;
	border-radius: 6dp;
	padding: 10dp;
	margin-bottom: 8dp;
	display: flex;
	flex-direction: column;
}

.activity-header
{
	font-size: 10dp;
	font-weight: bold;
	color: #b5bac1;
	text-transform: uppercase;
	margin-bottom: 6dp;
}

.activity-content
{
	display: flex;
	flex-direction: row;
}

.activity-image-wrap
{
	position: relative;
	width: 48dp;
	height: 48dp;
	margin-right: 10dp;
	flex-shrink: 0;
}

.activity-large-img
{
	width: 48dp;
	height: 48dp;
	border-radius: 6dp;
	display: block;
}

.activity-small-img
{
	position: absolute;
	bottom: -4dp;
	right: -4dp;
	width: 20dp;
	height: 20dp;
	border-radius: 10dp;
	border: 2dp #1e1f22;
	display: none;
}

.activity-small-img.visible
{
	display: block;
}

.activity-text-col
{
	display: flex;
	flex-direction: column;
	overflow: hidden;
}

.activity-name
{
	font-size: 13dp;
	font-weight: bold;
	color: #f2f3f5;
	line-height: 16dp;
}

.activity-details, .activity-state, .activity-timer
{
	font-size: 12dp;
	color: #949ba4;
	line-height: 16dp;
}

/* Member Since */
.dates-row
{
	font-size: 12dp;
	color: #dbdee1;
	margin-bottom: 4dp;
}

/* Roles */
.profile-roles-list
{
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
}

.role-pill
{
	display: flex;
	flex-direction: row;
	align-items: center;
	background-color: #242428;
	border-radius: 4dp;
	padding: 3dp 6dp;
	margin-right: 4dp;
	margin-bottom: 4dp;
	font-size: 11dp;
	color: #dbdee1;
}

.role-dot
{
	width: 8dp;
	height: 8dp;
	border-radius: 4dp;
	margin-right: 4dp;
}

/* Note */
.profile-note-input
{
	width: 100%;
	background-color: #1e1f22;
	color: #dbdee1;
	border-width: 0;
	border-radius: 4dp;
	padding: 6dp 8dp;
	font-size: 12dp;
	box-sizing: border-box;
}

.profile-note-input:focus
{
	background-color: #0b0b0c;
}

/* Footer & Message Button */
.profile-footer
{
	margin-top: 8dp;
}

.profile-message-btn
{
	width: 100%;
	background-color: #5865f2;
	color: #ffffff;
	font-size: 14dp;
	font-weight: 500;
	padding: 8dp 0;
	border-radius: 4dp;
	border-width: 0;
	cursor: pointer;
	text-align: center;
}

.profile-message-btn:hover
{
	background-color: #4752c4;
}

.profile-main { width: 100%; }
.profile-avatar-clip
{
	width: 68dp;
	height: 68dp;
	border-radius: 34dp;
	overflow: hidden;
}
.profile-more-btn { border-width: 0; padding: 0; tab-index: auto; }
.profile-more-btn:focus { background-color: #32343a; }
.profile-full-content { display: none; }
.profile-message-btn { tab-index: auto; }
.profile-message-btn:focus { background-color: #4752c4; }

#user-profile-root.full-profile .profile-banner { height: 114dp; }
#user-profile-root.full-profile .profile-header { height: 64dp; }
#user-profile-root.full-profile .profile-avatar-wrapper
{
	top: -56dp;
	width: 112dp;
	height: 112dp;
	border-radius: 56dp;
}
#user-profile-root.full-profile .profile-avatar-clip,
#user-profile-root.full-profile .profile-avatar-img
{
	width: 100dp;
	height: 100dp;
	border-radius: 50dp;
}

#user-profile-root.full-profile .profile-backdrop
{
	background-color: #000000c0;
	display: flex;
	align-items: center;
	justify-content: center;
	padding: 16dp;
	box-sizing: border-box;
}
#user-profile-root.full-profile .profile-card
{
	position: relative;
	max-width: 800dp;
	max-height: 660dp;
	flex-direction: row;
	background-color: #080809;
	border: 1dp #25262a;
	box-sizing: border-box;
}
#user-profile-root.full-profile .profile-main
{
	width: 310dp;
	height: 100%;
	flex-shrink: 0;
	overflow-y: auto;
	background-color: #111113;
}
#user-profile-root.full-profile .profile-body
{
	background-color: transparent;
	margin: 0;
	padding: 12dp 20dp 20dp;
}
#user-profile-root.full-profile .profile-scroll { max-height: none; overflow-y: visible; }
#user-profile-root.full-profile #profile-activities-section { display: none; }
#user-profile-root.full-profile .profile-full-content
{
	display: flex;
	flex-direction: column;
	position: relative;
	flex: 1;
	min-width: 0;
	height: 100%;
	padding: 48dp 24dp 20dp;
	box-sizing: border-box;
}
.profile-close
{
	position: absolute;
	top: 10dp;
	right: 10dp;
	width: 36dp;
	height: 36dp;
	border: 0;
	border-radius: 6dp;
	background-color: #202124;
	color: #f2f3f5;
	font-size: 22dp;
	text-align: center;
	line-height: 34dp;
	padding: 0;
	cursor: pointer;
	tab-index: auto;
}
.profile-close:hover, .profile-close:focus { background-color: #383a40; }
.profile-tabs
{
	display: flex;
	flex-direction: row;
	border-bottom: 1dp #292a2e;
	flex-shrink: 0;
}
.profile-tab
{
	background-color: transparent;
	border: 0;
	border-bottom: 2dp transparent;
	color: #b5bac1;
	font-size: 12dp;
	font-weight: bold;
	padding: 10dp 8dp;
	cursor: pointer;
	tab-index: auto;
}
.profile-tab:hover, .profile-tab:focus { color: #ffffff; background-color: #202124; }
.profile-tab.selected { color: #ffffff; border-bottom: 2dp #f2f3f5; }
.profile-full-results { position: relative; flex: 1; min-height: 0; overflow-y: auto; padding-top: 18dp; }
.profile-empty { position: absolute; top: 40%; left: 0; width: 100%; box-sizing: border-box; color: #b5bac1; font-size: 14dp; padding: 0 24dp; text-align: center; }
.profile-mutual-row
{
	display: flex;
	align-items: center;
	width: 100%;
	min-height: 52dp;
	box-sizing: border-box;
	padding: 8dp;
	margin-bottom: 2dp;
	border: 0;
	border-radius: 6dp;
	background-color: transparent;
	color: #f2f3f5;
	font-size: 14dp;
	text-align: left;
	cursor: pointer;
	tab-index: auto;
}
.profile-mutual-row:hover, .profile-mutual-row:focus { background-color: #202124; }
.profile-mutual-row:active { background-color: #292b30; }
.profile-mutual-image { display: block; width: 32dp; height: 32dp; flex-shrink: 0; margin-right: 12dp; border-radius: 16dp; overflow: hidden; background-color: #292b30; }
.profile-mutual-image img { display: block; width: 32dp; height: 32dp; image-color: #ffffff; }
.profile-mutual-server { border-radius: 8dp; }
.profile-mutual-name { flex: 1; min-width: 0; overflow: hidden; white-space: nowrap; }
