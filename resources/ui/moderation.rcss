#moderation-root { position: absolute; top: 0; left: 0; width: 100%; height: 100%; display: none; background-color: transparent; }
#moderation-root.open { display: block; }
#moderation-backdrop { width: 100%; height: 100%; background-color: #000000b3; display: flex; justify-content: center; align-items: center; }
#moderation-card { width: 440dp; max-width: 90%; max-height: 90%; background-color: #313338; border-radius: 6dp; overflow: auto; color: #dbdee1; }
#moderation-title { margin: 0; padding: 20dp 20dp 12dp; font-size: 20dp; color: #f2f3f5; }
#moderation-body { padding: 0 20dp 16dp; font-size: 14dp; line-height: 20dp; }
#moderation-body p { margin: 0 0 12dp; }
.moderation-label { font-weight: bold; margin: 12dp 0 6dp; }
#moderation-body textarea, #moderation-body input, #moderation-body select { width: 100%; box-sizing: border-box; padding: 8dp; background-color: #1e1f22; color: #f2f3f5; border-width: 0; border-radius: 4dp; font-size: 14dp; }
#moderation-body textarea { height: 88dp; }
#moderation-body select { height: 36dp; }
#moderation-error { color: #f28b82; padding: 0 20dp; }
#moderation-footer { display: flex; justify-content: flex-end; align-items: center; padding: 16dp 20dp; background-color: #2b2d31; }
#moderation-footer button, .moderation-reset { border-width: 0; border-radius: 4dp; padding: 8dp 18dp; font-size: 14dp; color: white; cursor: pointer; }
#moderation-cancel, .moderation-reset { background-color: transparent; margin-right: 12dp; }
#moderation-cancel:hover, .moderation-reset:hover { text-decoration: underline; }
#moderation-confirm { background-color: #5865f2; }
#moderation-confirm:hover { background-color: #4752c4; }
#moderation-confirm.danger { background-color: #da373c; }
#moderation-confirm.danger:hover { background-color: #a12828; }
#moderation-confirm:disabled { opacity: 0.5; }
#moderation-roles { max-height: 360dp; overflow-y: auto; margin-top: 8dp; }
.moderation-role { display: block; width: 100%; padding: 8dp; text-align: left; border-width: 0; border-radius: 4dp; background-color: transparent; color: #dbdee1; cursor: pointer; }
.moderation-role:hover { background-color: #404249; }
.moderation-role.disabled { opacity: 0.5; cursor: default; }
.moderation-check { display: inline-block; width: 20dp; }
.moderation-dot { display: inline-block; width: 10dp; height: 10dp; border-radius: 5dp; margin-right: 8dp; }
#moderation-body select { padding: 0; }
#moderation-body select selectvalue { padding: 8dp; }
#moderation-body select selectarrow { width: 24dp; height: 36dp; }
#moderation-body select selectbox { background-color: #111214; border: 1dp #202024; border-radius: 4dp; padding: 4dp; z-index: 200; max-height: 220dp; overflow-y: auto; }
#moderation-body select selectbox option { display: block; padding: 8dp 10dp; color: #dbdee1; border-radius: 4dp; }
#moderation-body select selectbox option:hover, #moderation-body select selectbox option:checked { background-color: #242428; color: #ffffff; }
#moderation-root button { tab-index: auto; }
#moderation-root button:focus { background-color: #4752c4; color: #ffffff; }
.moderation-role.disabled { tab-index: none; }
